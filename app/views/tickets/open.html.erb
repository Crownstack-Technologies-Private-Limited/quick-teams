<main class="relative z-0 flex-1 overflow-y-auto focus:outline-none">
  <main class="pb-8">
    <div class= "border-b border-gray-200">
      <div class="px-4 py-4  sm:flex sm:items-center sm:justify-between sm:px-6 lg:px-8">
        <div class="flex flex-wrap items-baseline -mt-2 -ml-2">
          <h1 class="text-2xl font-semibold tracking-tight text-gray-900">
            Tickets
          </h1>
          <p class="mt-1 ml-2 text-sm text-gray-500 truncate"><%= "(" + @tickets.count.to_s + " Tickets)" %></p>
        </div>
      </div>
      <% if policy([:ticket]).open? %>
        <div class="flex mt-4 sm:mt-0">
          <%= render partial: "tabs", locals: { tickets: @tickets } %>
        </div>
      <% end %>
    </div>
  </div>
  <!-- Main 3 column grid -->
  <section aria-labelledby="participants_section">
    <div class="overflow-hidden bg-white">
      <% if @tickets.size > 0 %>
        <div class="w-full overflow-hidden" data-controller="infinite-scroll">
          <%= render Ui::TableComponent.new(body_options: { id: "tickets", data: { "infinite-scroll-target": "entries" } }) do |table| %>
            <% table.with_column("description", class: "w-full") %>
            <% table.with_column("Created By") %>
            <% table.with_column("Label") %>
            <% table.with_column("Created On") %>
            <% table.with_column("Last Updated") %>
            <% table.with_column("Status") %>
            <% table.with_column("Assigned To") %>
            <%= render partial: "open_ticket", collection: @tickets, as: :ticket, cached: true %>
          <% end %>
          <%= render Ui::PaginationComponent.new(@pagy, class: "invisible", data: { "infinite-scroll-target": "pagination" }) %>
        </div>
      <% end %>
    </div>
  </section>
</div>
</div>
<div class="pt-4 pl-16 pr-16">
</div>
</main>

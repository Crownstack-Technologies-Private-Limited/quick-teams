<% ticket = ticket.decorate %>
<tr id="<%= dom_id ticket %>">
  <td class=" w-full table-cell">
    <a href="<%= ticket_path(ticket) %>", class="truncate hover:text-gray-600 hover:underline">
      <span class="text-gray-900 block whitespace-normal line-clamp-3 "><%= ticket.description.upcase_first %></span>
    </a>
  </td>
  <td class="table-cell">
    <span class="text-gray-900 text-left  whitespace-nowrap ">  <%= ticket.user.decorate.display_name %> </span>
  </td>
  <td class="table-cell">
    <%= render Ui::TagComponent.new(ticket.ticket_label.name.titleize, color: "gray", size: :badge, class: "whitespace-nowrap") %>
  </td>
  <td class="table-cell">
    <span class="text-gray-900 text-left  whitespace-nowrap ">  <%= display_created_at(ticket) %> </span>
  </td>
  <td class="table-cell">
    <span class="text-gray-900 text-left  whitespace-nowrap ">  <%= display_date(ticket.updated_at) %> </span>
  </td>
  <td class="table-cell">
    <%= render Ui::TagComponent.new(ticket.display_status, color: ticket.display_status_color, size: :badge, class: "whitespace-nowrap") %>
  </td>
</td>
<td class="table-cell">
  <span class="text-gray-900 text-left  whitespace-nowrap ">  <%= ticket.ticket_label.user.decorate.display_name %> </span>
</td>
</tr>

<%= render Ui::PageComponent.new(tag: :div) do %>
  <%= render Ui::PageHeaderComponent.new(title: "Project Observers", subtitle: "(" + @observers.size.to_s + ")") %>
<% end %>
<div class="flex w-full overflow-hidden bg-white">
  <div class="flex w-full">
    <% if @observers.any? %>
      <div class="w-full overflow-hidden">
        <%= render Ui::TableComponent.new do |table| %>
          <% table.with_column("Project", class: "w-1/3") %>
          <% table.with_column("Observers") %>
          <%= render partial: "project_observer", collection: @observers, as: :project %>
        <% end %>
      </div>
    <% else %>
      <%= render partial: "shared/no_result_found", cached: true %>
    <% end %>
  </div>
</div>

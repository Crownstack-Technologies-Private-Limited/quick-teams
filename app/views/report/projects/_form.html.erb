<div class="flex flex-col pt-5 pb-4 border-r border-gray-200">
  <div class="flex flex-col flex-1 w-64 h-0 overflow-y-auto">
    <div class="relative inline-block px-3 text-left">
      <nav class="px-3">
        <div>
          <h3 class="text-xs font-semibold tracking-wider text-gray-500 uppercase" id="teams-headline">
            Filter Projects
          </h3>
          <%= form_with url: projects_reports_path, method: :get do |form| %>
            <%= render Ui::FormContainerComponent.new do %>
              <div>
                <label for="date" class="form-label">
                  Manager
                </label>
                <%= form.collection_select(:manager_id, User.all_users.decorate, :id, :display_name, { :prompt => "Select Employee", :selected => (params["manager_id"] if !params["manager_id"].blank?) }, :class => "form-text-field mt-1") %>
              </div>
              <div>
                <label for="billed" class="form-label">
                  Status
                </label>
                <%= form.collection_select(:status, ProjectStatus.all.order(:name), :id, :name, { :prompt => "Select Status", :selected => (params["status"] if !params["status"].blank?) }, :class => "form-text-field mt-1") %>
              </div>
              <div>
                <label for="billed" class="form-label">
                  Tag
                </label>
                <%= form.collection_select(:tag, ProjectTag.all.order(:name), :id, :name, { :prompt => "Select Tag", :selected => (params["tag"] if !params["tag"].blank?) }, :class => "form-text-field mt-1") %>
              </div>
              <div class="flex justify-end mt-6">
                <%= render Ui::ButtonComponent.new("Reset", href: projects_reports_path, variant: :secondary) %>
                <%= render Ui::SubmitButtonComponent.new(form, "Search", class: "ml-2") %>
              </div>
            <% end %>
          <% end %>
        </div>
      </nav>
    </div>
  </div>
</div>

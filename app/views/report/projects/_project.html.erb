<% project = project.decorate %>
<tr>
  <td class="w-full table-cell whitespace-nowrap">
    <div class="flex items-center font-medium">
      <%= render Ui::StatusDotComponent.new(color: project.status.nil? ? "white" : project.status.color) %>
      <%= render Ui::TextLinkComponent.new(nil, project_schedules_path(project), tone: :row) do %>
        <span>
          <%= project.name %>
          <span class="font-normal text-gray-500"><%= project.display_discipline %></span>
        </span>
      <% end %>
    </div>
  </td>
  <td class="table-cell whitespace-nowrap">
    <% project.project_tags.uniq.each do |tag| %>
      <a href="<%= projects_reports_path(tag: tag.id) %>" class="hover:underline">
        <%= render Ui::TagComponent.new(tag.name.upcase_first, color: tag.color) %>
      </a>
    <% end %>
  </td>
  <td class="table-cell whitespace-nowrap">
    <% if !project.billable_resources.nil? %>
      <%= project.billable_resources.to_s %>
    <% end %>
  </td>
  <td class="table-cell whitespace-nowrap">
    <%= render Ui::TextLinkComponent.new(nil, (employee_team_path(project.manager) if !project.manager.nil?), tone: :row) do %>
      <%= project.display_manager_name %>
    <% end %>
  </td>
  <td class="table-cell whitespace-nowrap">
    <%= display_created_at(project) %>
  </td>
  <td class="table-cell whitespace-nowrap">
    <% unless project.status.nil? %>
      <a href="<%= projects_reports_path(status: project.status.id) %>" class="hover:underline">
        <%= render Ui::TagComponent.new(project.status.name.titleize, color: project.status.color) %>
      </a>
    <% end %>
  </td>
</tr>

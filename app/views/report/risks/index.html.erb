<%= render Ui::PageComponent.new(tag: :div) do %>
  <%= render Ui::PageHeaderComponent.new(title: "Opened Risks", subtitle: "(" + @risks.count.to_s + " risks)") %>
<% end %>
<div class="flex w-full overflow-hidden bg-white">
  <div class="flex w-full">
    <% if @risks.size > 0 %>
      <div class="w-full overflow-hidden">
        <%= render Ui::TableComponent.new do |table| %>
          <% table.with_column("Risk") %>
          <% table.with_column("project") %>
          <% table.with_column("Added by") %>
          <% table.with_column("created_at") %>
          <%= render partial: "risk", collection: @risks, as: :risk, cached: true %>
        <% end %>
      </div>
    <% else %>
      <%= render partial: "shared/no_result_found", cached: true %>
    <% end %>
  </div>
</div>

<%= render Ui::PageComponent.new(tag: :div) do %>
  <%= render Ui::PageHeaderComponent.new(title: "reports") %>
<% end %>
<div class="flex w-full overflow-hidden bg-white">
  <div class="flex w-full">
    <%= render partial: "form" %>
    <% if @reports.size > 0 %>
      <div class="w-full overflow-hidden" data-controller="infinite-scroll">
        <!-- This example requires Tailwind CSS v2.0+ -->
        <%= render Ui::TableComponent.new(body_options: { data: { "infinite-scroll-target": "entries" } }) do |table| %>
          <% table.with_column("report", class: "w-full") %>
          <% table.with_column("Created By") %>
          <% table.with_column("Status") %>
          <% table.with_column("Created At") %>
          <%= render partial: "report", collection: @reports, as: :report, cached: true %>
        <% end %>
        <%= render Ui::PaginationComponent.new(@pagy, class: "invisible", data: { "infinite-scroll-target": "pagination" }) %>
      </div>
    <% else %>
      <%= render partial: "shared/no_result_found", cached: true %>
    <% end %>
  </div>
</div>

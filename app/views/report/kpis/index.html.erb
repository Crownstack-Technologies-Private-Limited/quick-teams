<div class="relative z-0  flex-1 overflow-y-auto focus:outline-none">
  <!-- Page title & actions -->
  <div class="px-4 py-5 bg-white border-b border-gray-200 sm:flex sm:items-center sm:justify-between sm:px-6 lg:px-8">
    <div class="flex flex-wrap items-baseline -mt-2 -ml-2">
      <h1 class="text-2xl font-semibold tracking-tight text-gray-900">
        Employee KPIs Report
      </h1>
    </div>
    <% if @kpis.size > 0 and params[:participant_id].present? %>
      <div>
        <%= render Ui::ButtonComponent.new("Download PDF", href: performance_report_path(survey_type: params[:survey_type], participant_id: params[:participant_id], from_date: params[:from_date], to_date: params[:to_date], format: :pdf), target: "_blank") %>
      </div>
    <% end %>
  </div>
</div>
<div class="flex w-full overflow-hidden bg-white">
  <div class="flex w-full">
    <%= render partial: "form" %>
    <!-- This example requires Tailwind CSS v2.0+ -->
    <% if @kpis.size > 0 %>
      <div class="w-full overflow-auto" data-controller="infinite-scroll">
        <%= render Ui::TableComponent.new(body_options: { data: { "infinite-scroll-target": "entries" } }) do |table| %>
          <% table.with_column("KPI", class: "w-6/12") %>
          <% table.with_column("Participant") %>
          <% table.with_column("score") %>
          <% table.with_column("Taken by") %>
          <% table.with_column("Status", class: "px-10") %>
          <% table.with_column("created at") %>
          <% table.with_column("Comment") %>
          <%= render partial: "kpi", collection: @kpis, as: :kpi %>
        <% end %>
        <%= render Ui::PaginationComponent.new(@pagy, class: "invisible", data: { "infinite-scroll-target": "pagination" }) %>
      </div>
    <% else %>
      <%== render partial: "shared/no_result_found", cached: true %>
    <% end %>
  </div>
</div>

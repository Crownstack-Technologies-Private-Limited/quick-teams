<tr id="<%= dom_id kpi %>">
  <% participant = kpi.participant.decorate %>
  <% actor = kpi.actor.decorate %>
  <% kpi = kpi.decorate %>
  <td class="w-6/12  table-cell ">
    <a class="hover:underline" href="<%= survey_report_preview_path(kpi.survey, kpi) %>">
      <%= kpi.survey.name.upcase_first %>
    </a>
  </td>
  <td class=" table-cell  whitespace-nowrap">
    <a class="hover:underline" href="<%= employee_kpis_path(participant) %>">
      <%= participant.display_name %>
    </a>
  </td>
  <td class="table-cell whitespace-nowrap ">
    <%= kpi.display_score %>
  </td>
  <td class=" table-cell  whitespace-nowrap">
    <%= actor.display_name %>
  </td>
  <td class=" table-cell ">
    <div class= "ml-4 flex whitespace-nowrap">
      <% if kpi.submitted? %>
        <%= render Ui::IconComponent.new(:check_circle, class: "flex-shrink-0 mr-1.5 h-5 w-5 text-green-400") %>
        Submitted
      <% else %>
        <%= render Ui::IconComponent.new(:exclamation_circle, class: "flex-shrink-0 mr-1.5 h-5 w-5 text-yellow-400") %>
        In Progress
      <% end %>
    </div>
  </td>
  <td class="table-cell whitespace-nowrap">
    <%= display_date(kpi.created_at) %>
  </td>
  <td class="table-cell whitespace-nowrap">
  <% if kpi.comment.present? %>
    <%= render Ui::ButtonComponent.new("View", variant: :inline_edit, class: "underline mt-2 text-xs", data: { reflex: "click->EmployeeKpi#view_comment", comment: kpi.id.to_s }) %>
  </td>
  <% end %>
</tr>

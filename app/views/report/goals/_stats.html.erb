<%= render Ui::StatStripComponent.new(columns: 5) do |strip| %>
  <% strip.with_stat("Total Goals", stats.total) %>
  <% strip.with_stat("In Progress", stats.progress) %>
  <% strip.with_stat("Completed", stats.completed) %>
  <% strip.with_stat("Missed", stats.missed) %>
  <% strip.with_stat("Discarded", stats.discarded) %>
<% end %>

<div class="relative z-0 flex-1 overflow-y-auto focus:outline-none">
  <%= render Ui::PageHeaderComponent.new(title: "Goals") %>
</div>
<div class="flex w-full overflow-hidden bg-white">
  <div class="flex w-full">
    <%= render partial: "form" %>
    <% if @goals.size > 0 %>
      <div class="w-full overflow-hidden" data-controller="infinite-scroll">
        <%= render partial: "stats", locals: { stats: @stats } %>
        <!-- This example requires Tailwind CSS v2.0+ -->
        <%= render Ui::TableComponent.new(body_options: { data: { "infinite-scroll-target": "entries" } }) do |table| %>
          <% table.with_column("Title") %>
          <% table.with_column("Created By") %>
          <% table.with_column("Created_For") %>
          <% table.with_column("Created On") %>
          <% table.with_column("Deadline") %>
          <% table.with_column("Status") %>
          <%= render partial: "goal", collection: @goals, as: :goal, cached: true %>
        <% end %>
        <div class="flex justify-end invisible mt-2 mb-6 mr-2" data-infinite-scroll-target="pagination">
          <%== render partial: "shared/paginator", locals: { pagy: @pagy } %>
        </div>
      </div>
    <% else %>
      <%= render partial: "shared/no_result_found", cached: true %>
    <% end %>
  </div>
</div>

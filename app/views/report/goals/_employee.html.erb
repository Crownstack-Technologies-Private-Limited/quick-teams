<% employee = employee.decorate %>
<tr id ="<%= dom_id(employee) %>">
  <td class="table-cell whitespace-nowrap">
    <div class="flex items-center">
      <div class="flex-shrink-0">
        <%= display_medium_avatar(employee) %>
      </div>
      <%= render Ui::TextLinkComponent.new(nil, employee_goals_path(employee), tone: :row) do %>
        <div class="ml-4">
          <div class="text-sm font-medium text-gray-900">
            <%= employee.display_name %>
          </div>
          <div class="text-sm text-gray-500">
            <%= employee.email %>
          </div>
        </div>
      <% end %>
    </div>
  </td>
  <td class="table-cell whitespace-nowrap">
    <div class="text-sm text-gray-900"><%= employee.display_position %></div>
    <div class="text-sm text-gray-500"><%= employee.display_discipline_title %></div>
  </td>
  <td class="table-cell  whitespace-nowrap">
    <%= render Ui::TextLinkComponent.new(nil, (employee_team_path(employee.manager) if !employee.manager.nil?), tone: :row) do %>
      <%= employee.display_manager_name %>
    <% end %>
  </td>
  <td class="table-cell whitespace-nowrap">
    <% unless employee.status.nil? %>
      <%= render Ui::TagComponent.new(employee.status.name, color: employee.status.color) %>
    <% end %>
  </td>
</tr>

<div class="relative z-0 flex-1 overflow-y-auto focus:outline-none">
  <%= render Ui::PageHeaderComponent.new(title: "Available By Next Month", subtitle: "(" + @employees.count.to_s + " employees)") %>
</div>
<div class="flex w-full overflow-hidden bg-white">
  <div class="flex w-full">
    <% if @employees.size > 0 %>
      <div class="w-full overflow-hidden">
        <%= render Ui::TableComponent.new do |table| %>
          <% table.with_column("Name") %>
          <% table.with_column("Projects") %>
          <% table.with_column("Occupancy") %>
          <% table.with_column("Status") %>
          <%= render partial: "schedule", collection: @employees, as: :employee, cached: true %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<!DOCTYPE html>
<html lang="en" class="h-full">
  <head>
    <title>Quick Teams</title>
    <meta name="turbo-prefetch" content="false">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="color-scheme" content="light">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= action_cable_meta_tag %>
    <% if user_signed_in? %>
      <meta name="current-account" content="<%= Current.account.id %>">
    <% end %>
    <meta name="turbo-cache-control" content="no-cache">
    <% if content_for?(:head) %>
      <%= yield(:head) %>
    <% end %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap">
    <%= javascript_importmap_tags %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "https://ga.jspm.io/npm:trix@2.1.8/dist/trix.css", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "actiontext", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "slim", "data-turbo-track": "reload" %>
    <%= favicon_link_tag "favicon.png" %>
  </head>
  <body class="min-h-full bg-white font-sans text-gray-900">
    <% if user_signed_in? %>
      <%= render "shared/navbar/navbar" %>
      <div id="modal"></div>
    <% end %>
    <%= render Ui::ToastRegionComponent.new(below_app_bar: user_signed_in?) do %>
      <%= render Ui::FlashComponent.new(:notice, notice) %>
      <%= render Ui::FlashComponent.new(:alert, alert) %>
    <% end %>
    <main class="pb-12">
      <%= yield %>
    </main>
  </body>
</html>

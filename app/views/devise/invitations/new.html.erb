<%= render Ui::FormPageComponent.new(title: t("devise.invitations.new.header"), max_width: "max-w-xl") do %>
  <%= form_for(resource, as: resource_name, url: invitation_path(resource_name), html: { method: :post, class: "card card-body mt-6 space-y-5" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <% resource.class.invite_key_fields.each do |field| -%>
      <div class="field">
        <%= f.label field, class: "form-label" %>
        <%= f.text_field field, class: "form-text-field mt-1" %>
      </div>
    <% end -%>

    <div class="actions flex justify-end">
      <%= render Ui::SubmitButtonComponent.new(f, t("devise.invitations.new.submit_button")) %>
    </div>
  <% end %>
<% end %>

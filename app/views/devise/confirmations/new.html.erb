<%= render Ui::AuthPageComponent.new(title: "Resend confirmation instructions", heading_tag: :h2) do %>
  <%= form_for(resource, as: resource_name, url: confirmation_path(resource_name), html: { method: :post }) do |f| %>
    <%= render Ui::AuthCardComponent.new(resource: resource, class: "mt-4") do %>
      <%= render Ui::FormFieldComponent.new(label: "Email", for_id: "user_email") do %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-text-field", value: (resource.pending_reconfirmation? ? resource.unconfirmed_email : resource.email) %>
      <% end %>
      <div>
        <%= f.submit "Resend confirmation instructions", class: "btn-primary w-full py-2.5" %>
      </div>
      <% if controller_name != "sessions" %>
        <div class="text-sm text-center">
          <%= render Ui::TextLinkComponent.new("Log in", new_session_path(resource_name)) %>
        </div>
      <% end %>
    <% end %>
  <% end %>
<% end %>

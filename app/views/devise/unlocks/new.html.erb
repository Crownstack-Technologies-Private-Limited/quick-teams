<div class="page max-w-md">
  <h2 class="page-title">Resend unlock instructions</h2>

  <%= form_for(resource, as: resource_name, url: unlock_path(resource_name), html: { method: :post, class: "card card-body mt-6 space-y-5" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="field">
      <%= f.label :email, class: "form-label" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-text-field mt-1" %>
    </div>

    <div class="actions">
      <%= f.submit "Resend unlock instructions", class: "btn-primary w-full" %>
    </div>
  <% end %>

  <div class="mt-4 space-y-1 text-center text-sm [&_a]:font-medium [&_a]:text-primary-700 [&_a:hover]:underline">
    <%= render "devise/shared/links" %>
  </div>
</div>

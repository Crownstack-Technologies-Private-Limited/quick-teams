<%= render Ui::AuthPageComponent.new(title: "Change your password", heading_tag: :h2) do %>
  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
    <%= f.hidden_field :reset_password_token %>
    <%= render Ui::AuthCardComponent.new(resource: resource, class: "mt-4") do %>
      <%= render Ui::FormFieldComponent.new(label: "New Password", for_id: "user_password") do %>
        <% if @minimum_password_length %>
          <em>(<%= @minimum_password_length %> characters minimum)</em><br />
        <% end %>
        <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "form-text-field" %>
      <% end %>
      <%= render Ui::FormFieldComponent.new(label: "Confrim New Password", for_id: "user_password_confirmation") do %>
        <%= f.password_field :password_confirmation, autofocus: true, autocomplete: "new-password", class: "form-text-field" %>
      <% end %>
      <div>
        <%= f.submit "Change my password", class: "btn-primary w-full py-2.5" %>
      </div>
      <% if controller_name != "sessions" %>
        <div class="text-sm text-center">
          <%= render Ui::TextLinkComponent.new("Log in", new_session_path(resource_name)) %>
        </div>
      <% end %>
    <% end %>
  <% end %>
<% end %>

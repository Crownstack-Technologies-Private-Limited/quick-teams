<%= render Ui::AuthPageComponent.new(title: "Forgot your password?", heading_tag: :h2) do %>
  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
    <%= render Ui::AuthCardComponent.new(resource: resource, class: "mt-4") do %>
      <%= render Ui::FormFieldComponent.new(label: "Email Address", for_id: "user_email") do %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-text-field" %>
      <% end %>
      <div>
        <%= render Ui::SubmitButtonComponent.new(f, "Send me reset password instructions", class: "w-full py-2.5") %>
      </div>
      <% if controller_name != "sessions" %>
        <div class="text-sm text-center">
          <%= render Ui::TextLinkComponent.new("Log in", new_session_path(resource_name)) %>
        </div>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<div class="flex min-h-screen flex-col justify-center bg-linear-to-b from-primary-50/60 to-gray-50 px-4 py-12 sm:px-6 lg:px-8">
  <div class="sm:mx-auto sm:w-full sm:max-w-md">
    <a href="http://teams.quicklabs.in" class="mx-auto flex w-fit items-center gap-2.5 rounded-lg" aria-label="Quick Teams home">
      <span class="brand-mark h-10 w-10 rounded-xl text-base" aria-hidden="true">Q</span>
      <span class="brand-name text-lg">Quick Teams</span>
    </a>
    <h1 class="mt-8 text-center text-2xl font-semibold tracking-tight text-gray-900">
      Sign in to your account
    </h1>
    <p class="mt-2 text-center text-sm text-gray-600">
      Or
      <a href="<%= new_user_registration_path %>" class="font-medium text-primary-700 hover:text-primary-800 hover:underline">
        start your 14-day free trial
      </a>
    </p>
  </div>
  <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <%= hidden_field_tag :redirect_to, params[:redirect_to] %>

    <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-md">
      <div class="card space-y-5 px-5 py-8 shadow-sm sm:px-10">
        <div>
          <label for="user_email" class="form-label">
            Email Address
          </label>
          <div class="mt-1">
            <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-text-field" %>
          </div>
        </div>
        <div>
          <label for="user_password" class="form-label">
            Password
          </label>
          <div class="mt-1">
            <%= f.password_field :password, autocomplete: "current-password", class: "form-text-field" %>
          </div>
        </div>
        <% if devise_mapping.rememberable? %>
          <div class="flex items-center justify-between">
            <div class="flex items-center">
              <%= f.check_box :remember_me, class: "h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300 rounded" %>
              <label for="user_remember_me" class="ml-2 block text-sm text-gray-700">
                Remember me
              </label>
            </div>
          <% end %>
          <% -if devise_mapping.recoverable? && controller_name != "passwords" && controller_name != "registrations" %>
            <div class="text-sm">
              <a href="<%= new_password_path(resource_name) %>" class="font-medium text-primary-700 hover:text-primary-800 hover:underline">
                Forgot your password?
              </a>
            </div>
          </div>
        <% end %>
        <div>
          <%= f.submit "Log In", class: "btn-primary w-full py-2.5" %>
        </div>
        <% -if devise_mapping.confirmable? && controller_name != "confirmations" %>
          <div class="text-xs text-center ">
            <a href="<%= new_confirmation_path(resource_name) %>" class="font-medium text-primary-700 hover:text-primary-800 hover:underline">
              Didn't receive email confirmation instructions?
            </a>
          </div>
        <% end %>
      <% end %>
    </div>

<%= render Ui::AuthPageComponent.new(title: "Sign in to your account") do |page| %>
  <% page.with_subtitle do %>
    Or
    <%= render Ui::TextLinkComponent.new("start your 14-day free trial", new_user_registration_path) %>
  <% end %>
  <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
    <%= hidden_field_tag :redirect_to, params[:redirect_to] %>
    <%= render Ui::AuthCardComponent.new do %>
      <%= render Ui::FormFieldComponent.new(label: "Email Address", for_id: "user_email") do %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-text-field" %>
      <% end %>
      <%= render Ui::FormFieldComponent.new(label: "Password", for_id: "user_password") do %>
        <%= f.password_field :password, autocomplete: "current-password", class: "form-text-field" %>
      <% end %>
      <div class="flex items-center justify-between">
        <% if devise_mapping.rememberable? %>
          <%= render Ui::CheckboxFieldComponent.new(label: "Remember me", for_id: "user_remember_me") do %>
            <%= f.check_box :remember_me, class: Ui::CheckboxFieldComponent::INPUT_CLASS %>
          <% end %>
        <% end %>
        <% if devise_mapping.recoverable? && controller_name != "passwords" && controller_name != "registrations" %>
          <div class="text-sm"><%= render Ui::TextLinkComponent.new("Forgot your password?", new_password_path(resource_name)) %></div>
        <% end %>
      </div>
      <div>
        <%= f.submit "Log In", class: "btn-primary w-full py-2.5" %>
      </div>
      <% if devise_mapping.confirmable? && controller_name != "confirmations" %>
        <div class="text-xs text-center">
          <%= render Ui::TextLinkComponent.new("Didn't receive email confirmation instructions?", new_confirmation_path(resource_name)) %>
        </div>
      <% end %>
    <% end %>
  <% end %>
<% end %>

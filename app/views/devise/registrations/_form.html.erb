<%= turbo_frame_tag "sign_up_form", target: "_top" do %>
  <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
    <%= render Ui::AuthCardComponent.new(resource: resource) do %>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <%= render Ui::FormFieldComponent.new(label: "First Name", for_id: "user_first_name") do %>
          <%= f.text_field :first_name, autofocus: true, class: "form-text-field" %>
        <% end %>
        <%= render Ui::FormFieldComponent.new(label: "Last Name", for_id: "user_last_name") do %>
          <%= f.text_field :last_name, autofocus: true, class: "form-text-field" %>
        <% end %>
      </div>
      <%= render Ui::FormFieldComponent.new(label: "Email Address", for_id: "user_email") do %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-text-field" %>
      <% end %>
      <%= render Ui::FormFieldComponent.new(label: "Company Name", for_id: "user_company") do %>
        <%= f.text_field :company, autofocus: true, class: "form-text-field" %>
      <% end %>
      <%= render Ui::FormFieldComponent.new(label: "Password", for_id: "user_new_password") do %>
        <em class="form-help mt-0 mb-1 block not-italic">(6 characters minimum)</em>
        <%= f.password_field :new_password, autocomplete: "new_password", class: "form-text-field" %>
      <% end %>
      <%= render Ui::FormFieldComponent.new(label: "Password Confirmation", for_id: "user_new_password_confirmation") do %>
        <%= f.password_field :new_password_confirmation, autocomplete: "new_password_confirmation", class: "form-text-field" %>
      <% end %>
      <div class="actions">
        <%= render Ui::SubmitButtonComponent.new(f, "Sign up", class: "w-full py-2.5") %>
      </div>
    <% end %>
    <div class="text-sm text-center">
      <%= render Ui::TextLinkComponent.new("Log in", new_session_path(resource_name)) %>
    </div>
  <% end %>
<% end %>

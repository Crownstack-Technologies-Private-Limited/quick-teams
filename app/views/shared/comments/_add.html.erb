<div id="add">
  <% if goal.progress? %>
    <div class="px-4 py-6 bg-gray-50 sm:px-6">
      <div class="flex space-x-3">
        <div class="flex-shrink-0">
          <%= display_medium_avatar(current_user) %>
        </div>
        <div class="flex-1 min-w-0">
          <%= form_with model: comment, url: goal_comments_path, method: :post do |form| %>
            <%= render "shared/form_messages", resource: comment, message: local_assigns[:message] %>
            <%= form.hidden_field :user_id, :value => current_user.id %>
            <%= form.hidden_field :commentable_id, :value => goal.id %>
            <div>
              <textarea id="comment" name="comment[title]" rows="3" class="form-text-field" placeholder="Add a comment"></textarea>
            </div>
            <div data-controller="dropdown"  class="flex flex-wrap items-center justify-between gap-3 mt-3">
              <%= render Ui::RadioGroupComponent.new(name: "comment[status]", label: "Nature Of comment", selected: "stale",
          options: [["progress", "Progress", "green"], ["stale", "Stale", "yellow"], ["regress", "Regress", "red"]]) %>
              <%= render Ui::SplitSubmitButtonComponent.new(form, "Comment") do |button| %>
                <% button.with_option("and mark Missed") %>
                <% button.with_option("and mark Completed") %>
                <% button.with_option("and mark Discarded") %>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% elsif goal.missed? %>
    <div class="p-4 rounded-md bg-red-50">
      <div class="flex">
        <div class="flex-shrink-0">
          <%= render Ui::IconComponent.new(:x_circle, class: "w-5 h-5 text-red-400") %>
        </div>
        <div class="ml-3">
          <p class="text-sm font-medium text-red-800">
            Unfortunately, this goal was missed and was not completed.
          </p>
        </div>
      </div>
    </div>
  <% elsif goal.completed? %>
    <div class="p-4 rounded-md bg-green-50">
      <div class="flex">
        <div class="flex-shrink-0">
          <%= render Ui::IconComponent.new(:check_circle, class: "w-5 h-5 text-green-400") %>
        </div>
        <div class="ml-3">
          <p class="text-sm font-medium text-green-800">
            This goal was marked as complete.
          </p>
        </div>
      </div>
    </div>
  <% elsif goal.discarded? %>
    <div class="p-4 rounded-md bg-gray-50">
      <div class="flex">
        <div class="flex-shrink-0">
          <%= render Ui::IconComponent.new(:exclamation_triangle_solid, class: "w-5 h-5 text-gray-400") %>
        </div>
        <div class="ml-3">
          <p class="text-sm font-medium text-gray-800">
            This goal was discarded.
          </p>
        </div>
      </div>
    </div>
  <% end %>
</div>

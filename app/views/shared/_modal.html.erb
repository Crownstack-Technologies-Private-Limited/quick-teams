<%= render Ui::ModalComponent.new(title: title, icon: :exclamation) do |modal| %>
  <% modal.with_body { message } %>
  <% modal.with_footer do %>
    <% if main_button_visible %>
      <%= render Ui::ButtonComponent.new("Deactivate", variant: :danger, class: "w-full sm:w-auto") %>
    <% end %>
    <%= render Ui::ButtonComponent.new("Cancel", variant: :secondary, class: "w-full sm:w-auto", data: { action: "modal#close" }) %>
  <% end %>
<% end %>

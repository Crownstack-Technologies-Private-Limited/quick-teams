<% link = pagy_anchor(pagy) %>

<nav
  aria-label="Pagination"
  class="
    inline-flex overflow-hidden rounded-md border border-gray-300 bg-white
    shadow-xs pagy_nav pagination
  "
  role="navigation"
>
  <% if pagy.prev %>
    <span
      class="
        px-3 py-2 text-sm font-medium leading-tight text-gray-600 border-r
        border-gray-200 page prev hover:text-gray-900 hover:bg-gray-100
      "
    >
      <%== link.(pagy.prev, "&lt;", aria_label: "Previous") %>
    </span>
  <% else %>
    <span
      class="
        px-3 py-2 text-sm font-medium leading-tight text-gray-600 border-r
        border-gray-200 cursor-not-allowed page prev text-gray-300
        disabled
      "
    >
      <a role="link" aria-disabled="true" aria-label="Previous">&lt;</a>
    </span>
  <% end %>

  <% pagy.series.each do |item| %>
    <% if item.is_a?(Integer) %>
      <span
        class="
          px-3 py-2 text-sm font-medium leading-tight text-gray-600 border-r
          border-gray-200 page hover:text-gray-900 hover:bg-gray-100
        "
      >
        <%== link.(item) %>
      </span>
    <% elsif item.is_a?(String) %>
      <span
        class="
          px-3 py-2 text-sm font-semibold leading-tight text-primary-700
          bg-primary-50 border-r border-gray-200 page current
        "
      >
        <%= item %>
      </span>
    <% elsif item == :gap %>
      <span
        class="
          px-3 py-2 text-sm font-medium leading-tight text-gray-600 border-r
          border-gray-200 page gap hover:bg-gray-100
        "
      >
        <%== "&hellip;" %>
      </span>
    <% end %>
  <% end %>

  <% if pagy.next %>
    <span
      class="
        px-3 py-2 text-sm font-medium leading-tight text-gray-700
        text-gray-900 border-r border-transparent border-gray-200 page
        hover:text-gray-900 next hover:bg-gray-100
      "
    >
      <a
        href="<%== pagy_url_for(pagy, pagy.next) %>"
        rel="next"
        aria-disabled="true"
        aria-label="Next"
      >
        &gt;
      </a>
    </span>
  <% else %>
    <span
      class="
        px-3 py-2 text-sm font-medium leading-tight text-gray-600 border-r
        border-gray-200 cursor-not-allowed page next text-gray-300
        disabled
      "
    >
      <a role="link" aria-disabled="true" aria-label="Next">&gt;</a>
    </span>
  <% end %>
</nav>

<%= render Ui::ModalComponent.new(padded: false) do %>
  <div class="modal-header flex flex-shrink-0 items-center justify-between py-4 border-b border-gray-200 rounded-t-md">
    <h5 class="text-xl font-medium  text-gray-800" id="exampleModalLongLabel">
      Comment:
    </h5>
  </div>
  <div class="mt-2 flex">
    <span class="text-sm text-gray-500 py-4 text-left">
      <%= attempt.decorate.comment %>
    </span>
  </div>
  <%= render Ui::ButtonComponent.new("Close", variant: :secondary, data: { action: "modal#close" }) %>
<% end %>

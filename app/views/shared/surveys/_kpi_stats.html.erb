<turbo-frame id="stats">
  <section aria-labelledby="add-participant-section">
    <div class="overflow-hidden bg-white">
      <%= render Ui::TextComponent.new("Showing results from #{show_own_attempts ? "self" : "team"} assessment.", align: :center, class: "mt-1 max-w-4xl") %>
      <div class="px-4 justify-between flex">
        <div class="p-5">
          <% if current_user.admin? %>
            <%= render Ui::TextLinkComponent.new(nil, "/#{employee.account.id}/report/kpis?survey_type=2&participant_id=#{employee.id}", tone: :plain, class: "hover:underline") do %>
              <%= render Ui::SectionHeadingComponent.new(title: "KPIs Stats", tag: :h3) %>
            <% end %>
            <%= render Ui::TextLinkComponent.new(nil, "/#{employee.account.id}/surveys/#{kpi.id}/attempts", tone: :plain, class: "hover:underline") do %>
              <%= render Ui::TextComponent.new(kpi.name, class: "mt-2 max-w-4xl") %>
            <% end %>
          <% else %>
            <%= render Ui::SectionHeadingComponent.new(title: "KPIs Stats", tag: :h3) %>
            <%= render Ui::TextComponent.new(kpi.name, class: "mt-2 max-w-4xl") %>
          <% end %>
        </div>
        <%= render Ui::StatCardComponent.new(label: "Score (out of 10)", value: stats.average_score.to_s, variant: :plain, class: "p-4 bg-white text-right") %>
      </div>
      <ul>
        <% stats.contributions.each do |contribution| %>
          <%= render partial: "shared/surveys/progress_bar", locals: { title: contribution.category, score: contribution.score, scale: 10 } %>
        <% end %>
      </ul>
    </div>
  </section>
</turbo-frame>

<% question = question.decorate %>
<%= turbo_frame_tag dom_id(question) do %>
  <li class="py-3 flex border-b border-gray-200" data-actor-id=<%= current_user.id %> data-participant-type=<%= participant.class.name %> data-participant-id=<%= participant.id %> data-question-id=<%= question.id %>>
    <div class="ml-3 w-full">
      <p class="text-xs font-medium text-gray-500 uppercase"><%= question.display_category %></p>
      <p class="text-sm font-semibold text-gray-900"><%= question.display_text %></p>
      <% if question.description.present? %>
        <%= render Ui::TextComponent.new(question.display_description) %>
      <% end %>
      <% if question.explanation.present? %>
        <p class="text-xs text-gray-500"><b>Explanation for receiver: </b><%= question.display_explanation %></p>
      <% end %>
      <div class= "inline-flex">
        <%= render Ui::ButtonComponent.new("View summary", variant: :inline_edit, class: "underline mt-2 text-xs", data: { reflex: "click->SurveyParticipantStats#summary", "reflex-dataset": "combined" }) %>
        <% if policy([participant, :kpi]).record? %>
          <%= render Ui::ButtonComponent.new("Quick Assessment", variant: :inline_edit, class: "underline mt-2 text-xs px-4", data: { reflex: "click->EmployeeKpi#assessment", "reflex-dataset": "combined" }) %>
        <% end %>
      </div>
      <div id=<%= "summary_" + question.id.to_s %>   >
      </div>
    </div>
  </li>
<% end %>

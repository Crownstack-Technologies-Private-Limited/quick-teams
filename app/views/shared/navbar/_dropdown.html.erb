<div class="relative flex items-center">
  <%= render Ui::DropdownComponent.new(button_id: "user-menu", label: "More", button_variant: :nav, chevron: false, width: "w-60", wrapper_class: "z-10") do |menu| %>
    <% menu.with_trigger { render Ui::IconComponent.new(:dots_horizontal) } %>
    <% if policy(:ticket).index? %>
      <% menu.with_item("Tickets", tickets_path) %>
    <% end %>
    <% menu.with_item("Surveys & KRAs", surveys_path) %>
    <% menu.with_item("Report Templates", templates_path) %>
  <% end %>
</div>

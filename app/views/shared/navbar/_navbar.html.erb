<div data-reflex-permanent>
  <nav class="app-bar" id="menubar" aria-label="Main">
    <div class="flex flex-wrap items-center gap-x-3 gap-y-2 px-4 py-2.5 sm:flex-nowrap sm:px-6 lg:px-8">
      <%# Below sm the links live in a native <details> menu, so no JavaScript is involved. %>
      <details class="group relative sm:hidden">
        <summary class="icon-btn list-none border border-gray-200 [&::-webkit-details-marker]:hidden" aria-label="Main menu">
          <svg class="h-5 w-5 group-open:hidden" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 10a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 15a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z" clip-rule="evenodd" />
          </svg>
          <svg class="hidden h-5 w-5 group-open:block" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </summary>
        <div class="dropdown-panel absolute left-0 top-full z-40 mt-2 w-64 p-2">
          <%= render "shared/navbar/mobile_links" %>
        </div>
      </details>
      <%= render "shared/navbar/default" %>
      <div class="order-2 ml-auto flex shrink-0 items-center sm:order-none sm:ml-2">
        <!-- Profile dropdown -->
        <div class="relative z-10" data-controller="dropdown" data-action="click@window->dropdown#hide keydown.escape@window->dropdown#hide">
          <div>
            <button data-action="click->dropdown#toggle" data-dropdown-target="button" class="flex rounded-full text-sm ring-offset-2 transition hover:ring-2 hover:ring-gray-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500" id="user-menu" aria-haspopup="true" aria-label="Account menu for <%= current_user.email %>">
              <%= display_small_avatar(current_user) %>
            </button>
          </div>
          <div data-dropdown-target="menu" class="hidden absolute right-0 w-48 mt-2 origin-top-right transition ease-out duration-100">
            <div class="dropdown-panel absolute right-0 mt-2 w-64 origin-top-right" role="menu" aria-orientation="vertical" aria-labelledby="user-menu">
              <div class="px-4 py-3">
                <p class="text-sm font-medium text-gray-900">Signed in as</p>
                <p class="mt-0.5 truncate text-xs text-gray-500"><%= current_user.email %></p>
              </div>
              <div class="border-t border-gray-100 py-1">
                <div>
                  <% if current_user.admin? %>
                    <%= link_to "Account", current_user.is_owner? ? detail_path : account_disciplines_path, class: "dropdown-item", role: "menuitem" %>
                    <%= link_to "Archive", archived_projects_path, class: "dropdown-item", role: "menuitem" %>
                  <% end %>
                  <%= link_to "Settings", profile_path, class: "dropdown-item", role: "menuitem" %>
                  <%= link_to "Sign Out", destroy_user_session_path, data: { "turbo-method": :delete }, class: "dropdown-item", role: "menuitem" %>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </nav>
</div>

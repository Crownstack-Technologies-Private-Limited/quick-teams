<%= render "shared/navbar/brand" %>
<div class="hidden sm:ml-4 sm:flex sm:items-center">
  <div class="flex items-center gap-1">
    <% if policy(:home).index? %>
      <%= render Ui::NavItemComponent.new("Dashboard", home_path) %>
    <% end %>
    <% if policy(:team).index? %>
      <%= render Ui::NavItemComponent.new("Team", employees_path) %>
    <% end %>
    <% if policy(:projects).index? %>
      <%= render Ui::NavItemComponent.new("Projects", projects_path) %>
    <% end %>
    <% if policy(:schedules).index? %>
      <%= render Ui::NavItemComponent.new("Schedules", schedules_path) %>
    <% end %>
    <% if policy(:spaces).index? %>
      <%= render Ui::NavItemComponent.new("Spaces", spaces_path) %>
    <% end %>
    <%= render Ui::NavItemComponent.new("JobCards", employee_planner_daily_path(current_user), selected: current_page?(employee_planner_daily_path(current_user)) || current_page?(employee_planner_weekly_path(current_user))) %>
    <% if policy(:reports).index? %>
      <%= render Ui::NavItemComponent.new("Reports", reports_path) %>
    <% end %>

    <%= render "shared/navbar/dropdown" %>
  </div>
</div>
<%= render Ui::SearchFieldComponent.new(url: "/search/people-projects", placeholder: "Search Employee or Project", aria_label: "Search employee or project", variant: :navbar, wrapper_class: "order-3 w-full sm:order-none sm:ml-auto sm:w-64 lg:w-80") %>

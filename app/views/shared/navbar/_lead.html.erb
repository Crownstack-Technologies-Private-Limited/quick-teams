<%= render "shared/navbar/brand" %>
<div class="hidden sm:ml-4 sm:flex sm:items-center sm:flex-1">
  <div class="flex items-center gap-1">
    <a href=<%= employee_team_path(current_user) %> class= "<%= current_page?(employee_team_path(current_user)) ? "nav-selected" : "nav-unselected" %>" <%= 'aria-current=page' if current_page?(employee_team_path(current_user)) %>><%= current_user.first_name %></a>
    <% if policy(:projects).index? %>
      <a href=<%= projects_path %> class= "<%= current_page?(projects_path) ? "nav-selected" : "nav-unselected" %>" <%= 'aria-current=page' if current_page?(projects_path) %>>Projects</a>
    <% end %>
    <% if policy(:ticket).index? %>
      <a href=<%= tickets_path %> class= "<%= current_page?(tickets_path) ? "nav-selected" : "nav-unselected" %>" <%= 'aria-current=page' if current_page?(tickets_path) %>> Tickets </a>
    <% end %>
    <% if policy(:spaces).index? %>
      <a href=<%= spaces_path %> class= "<%= current_page?(spaces_path) ? "nav-selected" : "nav-unselected" %>" <%= 'aria-current=page' if current_page?(spaces_path) %>>Spaces</a>
    <% end %>
  </div>
</div>

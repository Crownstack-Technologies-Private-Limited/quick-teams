<%= render "shared/navbar/brand" %>
<div class="hidden sm:ml-4 sm:flex sm:items-center sm:flex-1">
  <div class="flex items-center gap-1">
    <%= render Ui::NavItemComponent.new(current_user.first_name, employee_schedules_path(current_user)) %>
    <% if policy(:projects).index? %>
      <%= render Ui::NavItemComponent.new("Projects", projects_path) %>
    <% end %>
    <% if policy(:ticket).index? %>
      <%= render Ui::NavItemComponent.new("Tickets", tickets_path) %>
    <% end %>
    <% if policy(:spaces).index? %>
      <%= render Ui::NavItemComponent.new("Spaces", spaces_path) %>
    <% end %>
  </div>
</div>

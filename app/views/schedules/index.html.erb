<% employees_count = @employees.load.size %>
<%= render Ui::PageComponent.new(tag: :div) do %>
  <%= render Ui::PageHeaderComponent.new(title: "Schedule", subtitle: "(Total: #{@total_resources}, Billable: #{@billable}, Billed: #{@billed}, Free: #{[@free_resources, 0].max.round(2)})") do |header| %>
    <% header.with_actions do %>
      <% occupancy_src = params[:job] ? "occupancy/jobs/#{params[:job]}" : (params[:role] ? "occupancy/roles/#{params[:role]}" : "occupancy") %>
      <%= turbo_frame_tag "occupancy", src: "/#{current_user.account.id}/#{occupancy_src}", target: "_top", loading: :lazy do %>
        <%= render Ui::LoadingComponent.new("Calculating Occupancy...") %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
<div class="flex w-full overflow-hidden bg-white">
  <div class="flex w-full">
    <%= render Ui::SideMenuComponent.new(id: "menu", layout: :filter, label: "Schedule filters") do |menu| %>
      <% menu.with_heading("Teams", id: "teams-headline") %>
      <% menu.with_item("All", schedules_path, selected: request.params[:job].nil? && request.params[:role].nil?) %>
      <% menu.with_heading("Jobs") %>
      <% @jobs.each do |job| %>
        <% menu.with_item(job.name, schedules_path(job: job.id), id: dom_id(job), selected: request.params[:job].to_i == job.id) %>
      <% end %>
      <% menu.with_heading("Roles") %>
      <% @roles.each do |role| %>
        <% menu.with_item(role.name, schedules_path(role: role.id), id: dom_id(role), selected: request.params[:role].to_i == role.id) %>
      <% end %>
    <% end %>
    <% if employees_count > 0 %>
      <div class="w-full overflow-hidden" data-controller="infinite-scroll">
        <%= render Ui::TableComponent.new(body_options: { data: { "infinite-scroll-target": "entries" } }) do |table| %>
          <% table.with_column("Name") %>
          <% table.with_column("Projects") %>
          <% table.with_column("Occupancy Now") %>
          <%= render partial: "schedules/schedule", collection: @employees, as: :employee, cached: false %>
        <% end %>
        <%= render Ui::PaginationComponent.new(@pagy, class: "invisible", data: { "infinite-scroll-target": "pagination" }) %>
      </div>
    <% else %>
      <%= render Ui::EmptyStateComponent.new(title: "No Schedules Found") %>
    <% end %>
  </div>
</div>

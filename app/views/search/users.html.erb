<% @employees.each do |employee| %>
  <%= render Ui::SearchResultComponent.new(href: employee_team_path(employee), id: "project-observer",
        data: { reflex: "click->ProjectObservers#add", "employee-id": employee.id, "project-id": @project.id }) do %>
    <%= employee.decorate.display_name %> (<%= employee.job.name if !employee.job.blank? %>)
  <% end %>
<% end %>

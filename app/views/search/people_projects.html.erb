<% @employees.each do |result| %>
  <%= render Ui::SearchResultComponent.new(href: employee_team_path(result)) do %>
    <%= result.decorate.display_name %> (<%= result.job.name if !result.job.blank? %>)
  <% end %>
<% end %>
<% if @projects.size > 0 && @employees.size > 0 %>
  <%= render Ui::SearchDividerComponent.new("Projects") %>
<% end %>
<% @projects.each do |result| %>
  <%= render Ui::SearchResultComponent.new(href: project_path(result)) do %>
    <%= result.decorate.display_name %>
  <% end %>
<% end %>
<% if (@projects.size > 0 or @employees.size > 0) && @jobs.size > 0 %>
  <%= render Ui::SearchDividerComponent.new("Jobs") %>
<% end %>
<% @jobs.each do |result| %>
  <%= render Ui::SearchResultComponent.new(href: schedules_path(:job => result.id)) do %>
    <%= result.name %>
  <% end %>
<% end %>

<%= render Ui::PageComponent.new do %>
  <!-- Page title & actions -->
  <div class="px-4 py-4    border-b border-gray-200 sm:flex sm:items-center sm:justify-between sm:px-6 lg:px-8">
    <div class="flex flex-wrap items-baseline -mt-2 -ml-2">
      <h1 class="text-2xl font-semibold tracking-tight text-gray-900">
        Select Survey
      </h1>
      <p class="mt-1 ml-2 text-sm text-gray-500 truncate"><%= "(" + @surveys.load.size.to_s + " Surveys)" %></p>
    </div>
    <%= render Ui::SearchFieldComponent.new(url: "/search/surveys", placeholder: "Search Survey", aria_label: "Search surveys", wrapper_class: "flex w-full max-w-3xl px-2 lg:ml-6") %>
    <div class="flex mt-4 sm:mt-0 sm:ml-4">
      <%= render Ui::ButtonComponent.new("New Survey", href: new_survey_path) %>
    </div>
  </div>
  <% if @surveys.size > 0 %>
    <div class="sm:block" data-controller="infinite-scroll">
      <div class="inline-block min-w-full align-middle ">
        <%= render Ui::TableComponent.new(body_options: { id: "surveys", data: { "infinite-scroll-target": "entries" } }) do |table| %>
          <% table.with_column("Surveys", class: "w-full") %>
          <% table.with_column("Added by") %>
          <% table.with_column("Survey type") %>
          <% table.with_column("Survey for") %>
          <% table.with_column("Created on") %>
          <%= render partial: "survey", collection: @surveys, as: :survey, cached: true %>
        <% end %>
        <%= render Ui::PaginationComponent.new(@pagy, class: "invisible", data: { "infinite-scroll-target": "pagination" }) %>
      </div>
    </div>
  <% else %>
    <%= render partial: "shared/no_result_found" %>
  <% end %>
<% end %>

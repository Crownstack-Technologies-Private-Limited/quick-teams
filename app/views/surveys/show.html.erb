<%= render Ui::PageComponent.new do %>
  <%= render partial: "survey/title", locals: { survey: @survey } %>
  <%= render Ui::SplitLayoutComponent.new(inset: false) do |layout| %>
    <% layout.with_primary do %>
      <section aria-labelledby="participants_section">
        <div class="overflow-hidden bg-white">
          <div class="w-full overflow-hidden" data-controller="infinite-scroll">
            <%= render Ui::TableComponent.new(body_options: { id: "surveys", data: { "infinite-scroll-target": "entries" } }) do %> <% end %>
            <div class="flex justify-end invisible mt-2 mb-6 mr-2" data-infinite-scroll-target="pagination">
            </div>
          </div>
        </div>
      </section>

    <% end %>
    <% if policy([:surveys]).create? %>
      <% layout.with_secondary do %>
        <section aria-labelledby="add-participant-section">
          <div class="overflow-hidden bg-white">
            <div class="px-4">
              <%= render partial: "surveys/questions/form", locals: { question: @question } %>
            </div>
          </div>
        </section>

      <% end %>
    <% end %>
  <% end %>
  <div class="pt-4 pl-16 pr-16">
  </div>
<% end %>

<%= tailwind_form_with(model: @survey, id: dom_id(@survey), url: survey_path(@survey)) do |form| %>
  <%= render Ui::FormContainerComponent.new do %>
    <%= render "shared/form_messages", resource: @survey, message: local_assigns[:message] %>
    <%= render "shared/form_header", title: "Edit Survey", subtitle: "A Survey list of questions. A survey can be a checklist or score. KRAs are also score survey." %>
    <input type="hidden" name="remember" value="true">
    <div class=" -space-y-px">
      <%= form.text_field :name, "Name", required: true, autocomplete: "off" %>
      <div class="sm:col-span-4 pt-6">
        <%= form.text_area :description, "Survey Description", required: true, class: "form-text-field h-24" %>
      </div>
      <div class="flex justify-end pt-5">
        <%= render Ui::BackButtonComponent.new() %>
        <%= render Ui::SubmitButtonComponent.new(form, "Edit Survey", class: "ml-2") %>
      </div>
    </div>
  <% end %>
<% end %>

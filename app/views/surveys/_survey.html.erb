<% survey = survey.decorate %>
<tr id="<%= dom_id survey %>">
  <td class="table-cell">
    <a href="<%= survey_questions_path(survey) %>" target="_top"  class="block hover:underline" target="_top">
      <div class="text-sm font-medium text-gray-900">
        <p class="line-clamp-2"> <%= survey.name.upcase_first %></p>
      </div>
      <div class="mt-1 text-sm text-gray-500">
        <p class="line-clamp-2"><%= survey.description.upcase_first %></p>
      </div>
    </a>
  </td>
  <td class="table-cell whitespace-nowrap">
    <div class="mt-1 text-sm text-gray-700">
      <%= render Ui::TextLinkComponent.new(nil, employee_team_path(survey.actor_id), tone: :row) do %>
        <p class=""><%= survey.actor.decorate.display_name %></p>
      <% end %>
    </div>
  </td>
  <td class="table-cell">
    <%= render Ui::TagComponent.new(survey.decorate.display_survey_type, color: survey.survey_type_color, size: :badge) %>
  </td>
  <td class="table-cell">
    <%= render Ui::TagComponent.new(survey.decorate.display_survey_for, color: survey.survey_for_color, size: :badge) %>
  </td>
  <td class="table-cell whitespace-nowrap">
    <div class="mt-1 text-sm text-gray-700">
      <p class=""><%= display_date(survey.created_at) %></p>
    </div>
  </td>
</tr>

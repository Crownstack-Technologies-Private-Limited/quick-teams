<% employee = employee.decorate %>
<%= render Ui::PageHeaderComponent.new(title: employee.display_name,
      subtitle: (employee.display_position if current_user.admin? || current_user.lead?),
      bordered: false, id: "employee-header") do |header| %>
  <% if current_user.admin? %>
    <% header.with_meta do %>
      <div class="flex">
        <div id="employee-tags" class="flex ml-4">
          <%= render partial: "employee/tags", locals: { employee: employee, tags: employee.people_tags } %>
        </div>
        <%= render Ui::DropdownComponent.new(button_id: "add", label: "Add tag", button_variant: :plain, chevron: false, wrapper_class: "mr-4",
              button_class: "inline-flex items-center p-1 ml-2 text-primary-700 bg-primary-50 border border-primary-200 rounded-full hover:bg-primary-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-primary-500") do |menu| %>
          <% menu.with_trigger { render Ui::IconComponent.new(:plus, class: "w-4 h-4") } %>
          <% if @tags.empty? %>
            <p role="menuitem" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">No people tag added yet</p>
            <%= link_to "Add People Tags", account_people_tags_path, class: "block px-4 py-2 text-sm text-primary-700 hover:bg-gray-50 hover:underline" %>
          <% else %>
            <% @tags.each do |tag| %>
              <% menu.with_item(tag.name, "#", data: { action: "click->dropdown#close", reflex: "click->EmployeeTags#change", "employee-id": employee.id, "tag-id": tag.id }) %>
            <% end %>
          <% end %>
        <% end %>
      </div>
    <% end %>
    <% header.with_actions do %>
      <div id="employee-status" class="flex">
        <%= render partial: "employee/status", locals: { employee: employee } %>
      </div>
      <%= render Ui::DropdownComponent.new(button_id: "menu-button", wrapper_class: "mr-2") do |menu| %>
        <% menu.with_trigger { "Status" } %>
        <% if @statuses.empty? %>
          <p role="menuitem" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">No people status added yet</p>
          <%= link_to "Add People Status", account_people_statuses_path, class: "block px-4 py-2 text-sm text-primary-700 hover:bg-gray-50 hover:underline" %>
        <% else %>
          <% @statuses.each do |status| %>
            <% menu.with_item(status.name, "#", data: { action: "click->dropdown#close", reflex: "click->EmployeeStatus#change", "employee-id": employee.id, "status-id": status.id }) %>
          <% end %>
        <% end %>
      <% end %>
      <div>
        <%= render Ui::ButtonComponent.new("Edit", href: edit_employee_path(employee), variant: :secondary) %>
      </div>
      <div>
        <% if employee.active %>
          <%= confirm_button(deactivate_user_path(employee), "Deactivate", "Are you sure?", "ml-4 btn-secondary") %>
        <% else %>
          <%= confirm_button(activate_user_path(employee), "Activate", "Are you sure?", "ml-4 btn-secondary") %>
        <% end %>
      </div>
    <% end %>
  <% end %>
<% end %>
<%= render partial: "employee/tabs", locals: { employee: employee } %>

<%= render Ui::PageComponent.new do %>
  <%= render "employee/title", employee: @employee %>
  <%= render Ui::SplitLayoutComponent.new(inset: false) do |layout| %>
    <% layout.with_primary do %>
      <% unless @kpi.nil? %>
        <section aria-labelledby="participants_section">
          <div class="overflow-hidden bg-white">
            <div class="p-4">
              <div class="flex flex-wrap">
                <p class="mt-1 text-sm font-medium text-gray-900 truncate"><%= "KRAs Questions set (" + @kpi.questions.load.size.to_s + ")" %></p>
              </div>
              <ul class="divide-y divide-gray-200" id="questions">
                <%= render partial: "shared/surveys/question", collection: @kpi.questions.order(:question_category_id), locals: { as: :question, participant: @employee }, cached: false %>
              </ul>
            </div>
          </div>
        </section>
      <% end %>
    <% end %>
    <% layout.with_secondary do %>
      <% if @kpi.nil? %>
        <%= render Ui::TextComponent.new("No KRAs have been assinged yet. If you are an admin, you can set KRAs from surveys page. If not, please connect with the admin.", class: "mt-2 p-4 max-w-4xl") %>
      <% else %>
        <%= turbo_frame_tag "stats", src: "/#{@employee.account.id}/employees/#{@employee.id}/culture/#{@kpi.id}/stats", target: "_top", loading: :lazy do %>
          <%= render Ui::LoadingComponent.new("Hold on a sec while I fetch stats...", class: "px-8") %>
        <% end %>
        <% if policy([@employee, :culture]).record? %>
          <div class="text-center mt-4">
            <h3 class="mt-2 text-sm font-medium text-gray-900">Record New Assessment</h3>
            <%= render Ui::TextComponent.new("#{@employee.decorate.display_name} has been assigned #{@kpi.name.upcase_first}. Please click on button below to record a new assessment.", class: "mt-1 px-8") %>
            <div class="mt-2">
              <%= confirm_button(new_survey_attempt_path(@kpi, participant_id: @employee.id), "Record Assessment", "The result of your assessment will be used to calculate overall KRAs performance. Are you sure you want to proceed?", "btn-primary") %>
            </div>
          </div>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<tr id="<%= dom_id report %>">
  <% report = report.decorate %>
  <td class="w-full table-cell">
    <%= link_to report.display_title, employee_report_path(report.reportable, report), class: "btn-intdne-edit pl-2 hover:underline" %>
  </td>
  <td class="table-cell">
    <%= render Ui::TagComponent.new(report.submitted ? "Submitted" : "Draft", color: report.display_status, size: :badge) %>
  </td>
  <td class="table-cell whitespace-nowrap">
    <span class="font-medium text-gray-500"><%= display_created_at(report) %></span>
  </td>
  <td class="table-cell whitespace-nowrap">
    <% if policy([report.reportable, report]).edit? %>
      <%= edit_button(edit_employee_report_path(report.reportable, report)) %>
    <% end %>
    <% if policy([report.reportable, report]).destroy? %>
      <%= delete_button(employee_report_path(report.reportable, report)) %>
    <% end %>
  </td>
</tr>

  <%= render Ui::FormContainerComponent.new(width: "max-w-4xl") do %>
  <div class="px-4">
    <%= tailwind_form_with(model: report, id: dom_id(report), url: employee_reports_path(@employee)) do |form| %>
      <main class="w-full px-4 pt-6 pb-12 mx-auto space-y-4 lg:pb-16">
        <%= render "shared/form_messages", resource: report, message: local_assigns[:message] %>
        <%= render "shared/form_header", title: "Add New Report", subtitle: "A report can be general update about goals, progress or anything you want to share with your team." %>
        <%= form.text_field :title, "Title", autocomplete: "off" %>
        <%= form.rich_text_area :body, "Description" %>
        <div class="flex justify-between">
          <div class="">
            <%= render Ui::ButtonComponent.new("Cancel", href: employee_reports_path(@employee), variant: :secondary) %>
          </div>
          <div class="">
            <%= form.submit "Save As Draft", :name => "draft", class: "btn-secondary" %>
            <%= render Ui::SubmitButtonComponent.new(form, "Submit Report", class: "ml-2", data: {
                                               controller: "confirmation",
                                               "confirmation-message-value": "Are you sure you want to submit it? You won't be able to edit it after this.",
                                               action: "confirmation#confirm",
                                             }) %>
          </div>
        </div>
      </main>
    <% end %>
  </div>
<% end %>

<%= render Ui::FormContainerComponent.new(width: "max-w-4xl") do %>
  <div class="px-4">
    <%= tailwind_form_with(model: @feedback, id: dom_id(@feedback), url: employee_feedback_path(@employee, @feedback), method: :patch) do |form| %>
      <main class="w-full px-4 pt-6 pb-12 mx-auto space-y-4 lg:pb-16">
        <%= render "shared/form_messages", resource: @feedback, message: local_assigns[:message] %>
        <%= render "shared/form_header", title: "Edit Feedback for #{@employee.decorate.display_name}", subtitle: "A feedback can be added for employee which might be useful in performace review later. Feedback will be visible to employee after approval from Admin." %>
        <%= form.text_field :title, "Title", autocomplete: "off" %>
        <%= form.rich_text_area :body, "Description" %>
        <%= render Ui::FormFieldComponent.new(label: "Feedback Type", for_id: "feedback_feedback_type") do %>
          <%= form.select :feedback_type, Feedback.feedback_types.keys.map { |k| [k.titleize, k] }, {}, class: "form-text-field" %>
        <% end %>
        <%= render Ui::CheckboxFieldComponent.new(label: "Mark as KPI", for_id: "feedback_is_kpi", help: "Mark this feedback as a Key Performance Indicator (KPI) for the employee.") do %>
          <%= form.check_box :is_kpi, class: Ui::CheckboxFieldComponent::INPUT_CLASS %>
        <% end %>
        <%= render Ui::FormActionsComponent.new do %>
          <%= render Ui::BackButtonComponent.new() %>
          <%= render Ui::SubmitButtonComponent.new(form, "Edit Feedback", class: "ml-2") %>
        <% end %>
      </main>
    <% end %>
  </div>
<% end %>

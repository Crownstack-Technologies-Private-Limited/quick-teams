<main class="relative z-0 flex-1 overflow-y-auto focus:outline-none">
  <%= render "employee/title", employee: @employee %>
  <main class="pb-8">
    <div>
      <!-- Main 3 column grid -->
      <div class="grid items-start grid-cols-1  lg:grid-cols-3">
        <!-- Left column -->
        <div class="grid grid-cols-1 gap-4 lg:col-span-2" data-controller="infinite-scroll">
          <section aria-labelledby="participants_section">
            <div class="w-full overflow-hidden">
              <%= render Ui::TableComponent.new(body_options: { id: "feedbacks", data: { "infinite-scroll-target": "entries" } }) do |table| %>
                <% table.with_column("Title", class: "w-full") %>
                <% table.with_column("Status", class: "px-6") %>
                <% table.with_column("Added by", class: "px-6") %>
                <% table.with_column("ADDED ON") %>
                <% table.with_column("Action") %>
                <%= render partial: "feedback", collection: @feedbacks, cached: false %>
              <% end %>
              <div class="flex justify-end invisible mt-2 mb-6 mr-2" data-infinite-scroll-target="pagination">
                <%== render partial: "shared/paginator", locals: { pagy: @pagy } %>
              </div>
            </div>
          </section>
        </div>
        <% if policy([@employee, Feedback]).create? %>
          <!-- Right column -->
          <div class="grid grid-cols-1 gap-4 xl:border-l xl:border-gray-200">
            <section aria-labelledby="add-participant-section">
              <div class="overflow-hidden bg-white">
                <div class="px-4">
                  <%= render "employee/feedbacks/form", feedback: @feedback %>
                </div>
              </div>
            </section>
          </div>
        <% end %>
      </div>
    </div>
  </main>
  <div class="pt-4 pl-16 pr-16">
  </div>
</main>

<!-- This example requires Tailwind CSS v2.0+ -->
<%= render Ui::FormContainerComponent.new(width: "max-w-4xl") do %>
  <div class="px-4 py-4 sm:flex sm:items-center sm:justify-between sm:px-6 lg:px-8">
    <div class="flex-1 min-w-0">
      <h3 class="flex items-center space-x-3 text-xl font-semibold tracking-tight text-gray-900">
        <%# Feedback type indicator %>
        <% type_color = { "positive" => "green", "negative" => "red", "neutral" => "gray" }.fetch(@feedback.feedback_type, "gray") %>
        <%= render Ui::StatusDotComponent.new(color: type_color, class: "inline-block w-4! h-4! align-middle mr-2", "aria-label": @feedback.feedback_type.to_s.titleize, role: "img") %>
        <span><%= highlight_hashtag(@feedback.title.upcase_first) %></span>
        <% if @feedback.is_kpi? %>
          <%= render Ui::BadgeComponent.new("KPI", color: :brand, class: "ml-2") %>
        <% end %>
      </h3>
      <div class="flex mt-4 space-x-3">
        <div class="flex-shrink-0">
          <%= display_medium_avatar(@feedback.critiquable) %>
        </div>
        <div>
          <div class="text-sm">
            <%= render Ui::TextLinkComponent.new(@feedback.critiquable.decorate.display_name, employee_feedbacks_path(@feedback.critiquable), tone: :strong) %>
          </div>
          <div class="mt-1 space-x-2 text-sm">
            <span class="font-medium text-gray-500"><%= @feedback.user.decorate.display_name + " added on " + display_created_at(@feedback) %></span>
          </div>
        </div>
      </div>
    </div>
    <div class="flex mt-4 sm:mt-0 sm:ml-4">
      <%= render Ui::BackButtonComponent.new() %>
    </div>
    <% if policy([@employee, @feedback]).edit? %>
      <%= render Ui::ButtonComponent.new("Edit", href: edit_employee_feedback_path(@feedback.critiquable, @feedback), class: "ml-2") %>
    <% end %>
  </div>
  <% cache @feedback do %>
    <div class="mt-1 text-sm text-gray-700 sm:px-6 lg:px-8">
      <p><%= @feedback.body %></p>
    </div>
  <% end %>
  <% if current_user.admin? %>
    <div id="feedback-status-<%= @feedback.id %>">
      <%= render partial: "employee/feedbacks/status", locals: { feedback: @feedback } %>
    </div>
  <% end %>
<% end %>

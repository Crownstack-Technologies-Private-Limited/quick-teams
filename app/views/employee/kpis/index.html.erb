<%= render Ui::PageComponent.new do %>
  <%= render "employee/title", employee: @employee %>
  <%= render Ui::SplitLayoutComponent.new(inset: false) do |layout| %>
    <% layout.with_primary do %>
      <% unless @kpi.nil? %>
        <section aria-labelledby="participants_section">
          <div class="overflow-hidden bg-white">
            <div class="p-4">
              <div class="flex flex-wrap">
                <p class=" mt-1 text-sm font-medium text-gray-900 truncate"><%= "KRAs Questions set (" + @kpi.questions.load.size.to_s + ")" %></p>
              </div>
              <ul class="divide-y divide-gray-200" id="questions">
                <%= render partial: "shared/surveys/question", collection: @kpi.questions.order(:question_category_id), locals: { as: :question, participant: @employee }, cached: false %>
              </ul>
            </div>
          </div>
        </section>
      <% end %>

    <% end %>
    <% layout.with_secondary do %>
      <% if @kpi.nil? %>
        <p class="mt-2 p-4 max-w-4xl text-sm text-gray-500">No KRAs have been assinged yet. If you are an admin, you can set KRAs from surveys page. If not, please connect with the admin. </p>
      <% else %>
        <div class="flex justify-center mt-4" data-employee-id="<%= @employee.id %>">
          <%= render Ui::ButtonGroupComponent.new do |group| %>
  <% group.with_button("Self Assessment", data: { reflex: "click->EmployeeKpi#self_assessment", "reflex-dataset": "combined" }) %>
  <% group.with_button("Team Assessment", data: { reflex: "click->EmployeeKpi#team_assessment", "reflex-dataset": "combined" }) %>
<% end %>
        </div>
        <%= turbo_frame_tag "stats", src: "/#{@employee.account.id}/employees/#{@employee.id}/kpis/#{@kpi.id}/stats", target: "_top", loading: :lazy do %>
          <%= render Ui::LoadingComponent.new("Hold on a sec while I fetch stats...") %>
        <% end %>
        <% if policy([@employee, :kpi]).self_record? %>
          <div class="text-center mt-2">
            <h3 class="mt-2 text-sm font-medium text-gray-900">Record Self Assessment</h3>
            <p class="mt-1 text-sm text-gray-500 px-8">
              You have been assigned <%= @kpi.name.upcase_first %>. Please click on button below to record a new self assessment.
            </p>
            <div class="mt-2">
              <%= confirm_button(new_survey_attempt_path(@kpi, participant_id: @employee.id), "Record Self Assessment", "The result of your assessment will be used to calculate overall KRAs performance. Are you sure you want to proceed?", "btn-primary") %>
            </div>
          </div>
        <% elsif policy([@employee, :kpi]).record? %>
          <div class="text-center mt-4">
            <h3 class="mt-2 text-sm font-medium text-gray-900">Record New Assessment</h3>
            <p class="mt-1 text-sm text-gray-500 px-8">
              <%= @employee.decorate.display_name %> has been assigned <%= @kpi.name.upcase_first %>. Please click on button below to record a new assessment.
            </p>
            <div class="mt-2">
              <%= confirm_button(new_survey_attempt_path(@kpi, participant_id: @employee.id), "Record Assessment", "The result of your assessment will be used to calculate overall KRAs performance. Are you sure you want to proceed?", "btn-primary") %>
            </div>
          </div>
        <% end %>
      <% end %>

    <% end %>
  <% end %>
<% end %>

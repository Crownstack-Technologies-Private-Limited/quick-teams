<% if employee.people_tags.load.size > 0 %>
  <% employee.people_tags.uniq.each do |tag| %>
    <%= render Ui::TagComponent.new(tag.name, color: tag.color, size: :sm, class: "ml-2",
          remove: { id: "remove", data: { reflex: "click->EmployeeTags#remove", "tag-id": tag.id, "employee-id": employee.id } }) %>
  <% end %>
<% end %>

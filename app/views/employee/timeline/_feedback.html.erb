<%= render Ui::TimelineItemComponent.new(user: event.user, timestamp: display_created_at(event)) do %>
  <%= render Ui::TextLinkComponent.new(event.user.decorate.display_name, employee_timeline_path(event.user), tone: :strong) %>
  added a new feedback 
  <% if event.trackable.nil? %>
    which does not exist anymore
  <% else %>
    titled
    <%= render Ui::TextLinkComponent.new(highlight_hashtag(event.trackable.title.upcase_first), employee_feedback_path(event.eventable, event.trackable), tone: :strong) %>
  <% end %>
  for
  <%= render Ui::TextLinkComponent.new(event.eventable.first_name + " " + event.eventable.last_name, employee_feedbacks_path(event.eventable), tone: :strong) %>
<% end %>

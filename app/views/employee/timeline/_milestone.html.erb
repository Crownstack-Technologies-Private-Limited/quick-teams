<%= render Ui::TimelineItemComponent.new(user: event.user, timestamp: display_created_at(event)) do %>
  <%= render Ui::TextLinkComponent.new(event.user.decorate.display_name, employee_timeline_path(event.user), tone: :strong) %>
  added a new milestone 
  <% if event.trackable.nil? %>
    which does not exist anymore
  <% else %>
    titled
    <%= render Ui::TextLinkComponent.new(highlight_hashtag(event.trackable.title.upcase_first), project_milestone_path(event.eventable, event.trackable), tone: :strong) %>
  <% end %>
  in 
  <%= render Ui::TextLinkComponent.new(event.eventable.decorate.display_name, project_milestones_path(event.eventable), tone: :strong) %>
<% end %>

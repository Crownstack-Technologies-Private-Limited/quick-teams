<%= render Ui::PageComponent.new do %>
  <%= render "employee/title", employee: @employee %>
  <%= render Ui::SplitLayoutComponent.new do |layout| %>
    <% layout.with_primary(data: { "controller": "infinite-scroll" }) do %>
      <section aria-labelledby="participants_section">
        <h2 class="sr-only" id="section-1-title">Employee Feedbacks</h2>
        <div class="overflow-hidden bg-white">
          <div class="p-4">
            <div class="flex flex-wrap">
              <p class="pb-2 mt-1 text-sm font-medium text-gray-900 truncate"><%= "Employee Timeline" %></p>
            </div>
            <ul data-infinite-scroll-target="entries">
              <% @events.each do |event| %>
                <%= render partial: "employee/timeline/activity", locals: { event: event } %>
              <% end %>
            </ul>
          </div>
        </div>
        <%= render Ui::PaginationComponent.new(@pagy, class: "invisible", data: { "infinite-scroll-target": "pagination" }) %>
      </section>

    <% end %>
  <% end %>
<% end %>

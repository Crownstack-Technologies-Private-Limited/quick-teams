<% frame_id = dom_id(@employee, "#{params["attribute"]}") %>

<%= turbo_frame_tag frame_id do %>
  <%= form_with(model: @employee, url: employee_update_path(@employee)) do |form| %>
    <li class="flex">
      <div class="w-full">
        <% if params["attribute"] == "about" %>
          <%= form.text_area :"#{params["attribute"]}", class: "form-text-field h-24 whitespace-pre-wrap", style: "" %>
        <% else %>
          <%= form.text_field :"#{params["attribute"]}", class: "form-text-field", style: "" %>
        <% end %>
      </div>
      <div class="ml-1">
        <%= render Ui::SubmitButtonComponent.new(form, "Save", class: "justify-end") %>
      </div>
      <div class="ml-1">
        <%= render Ui::ButtonComponent.new("Cancel", href: employee_about_index_path, variant: :secondary) %>
      </div>
    </li>
  <% end %>
<% end %>

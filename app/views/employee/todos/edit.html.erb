<%= tailwind_form_with(model: @todo, id: dom_id(@todo), url: employee_todo_path(@employee, @todo), method: :patch) do |form| %>
  <%= render Ui::FormContainerComponent.new do %>
    <%= render "shared/form_messages", resource: @todo, message: local_assigns[:message] %>
    <%= render "shared/form_header", title: "Edit Todo for #{@employee.decorate.display_name}", subtitle: "Todo are short term goals" %>
    <%= form.text_field :title, "Title", autocomplete: "off" %>
    <%= form.text_area :body, "Description(optional)", class: "form-text-field h-24" %>
    <div>
      <label for="date" class="form-label">
        Due Date
      </label>
      <%= form.date_field :deadline, class: "form-text-field mt-1" %>
    </div>
    <%= render Ui::FormActionsComponent.new do %>
      <%= render Ui::BackButtonComponent.new() %>
      <%= render Ui::SubmitButtonComponent.new(form, "Edit Todo", class: "ml-2") %>
    <% end %>
  <% end %>
<% end %>

<%= turbo_frame_tag dom_id(@schedule) do %>
  <%= form_with(model: @schedule, id: dom_id(@schedule), url: employee_schedule_path(@employee, @schedule)) do |form| %>
    <%= render "shared/form_messages", resource: @schedule, message: local_assigns[:message] %>
    <%= render Ui::InlineEditFormComponent.new(title: "Edit #{@schedule.project.name}'s schedule") do |row| %>
      <% row.with_field do %>
        <%= form.hidden_field :project_id, value: @schedule.project_id %>
        <%= render Ui::FormFieldComponent.new(label: "Starts At") do %><%= form.date_field :starts_at, class: "form-text-field" %><% end %>
      <% end %>
      <% row.with_field do %>
        <%= render Ui::FormFieldComponent.new(label: "Ends At") do %><%= form.date_field :ends_at, class: "form-text-field" %><% end %>
      <% end %>
      <% row.with_field do %>
        <%= render Ui::FormFieldComponent.new(label: "Occupancy(%)") do %><%= form.text_field :occupancy, class: "form-text-field", autocomplete: "off" %><% end %>
      <% end %>
      <% row.with_field do %>
        <% if @schedule.project.billable %>
          <%= render Ui::FormFieldComponent.new(label: "Billable") do %><%= form.select :billable, Schedule::SCHEDULE_OPTIONS, {}, class: "form-text-field" %><% end %>
        <% else %>
          <%= render Ui::FormFieldComponent.new(label: "Billable", help: "Project is non billable hence this schedule is non-billable as well.") %>
        <% end %>
      <% end %>
      <% row.with_submit do %>
        <%= render Ui::SubmitButtonComponent.new(form, "Save", class: "ml-2 mt-6") %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

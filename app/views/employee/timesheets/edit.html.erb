<%= form_with(model: @timesheet, id: dom_id(@timesheet), url: employee_timesheet_path(@employee, @timesheet)) do |form| %>
  <%= render Ui::FormContainerComponent.new do %>
    <%= render "shared/form_messages", resource: @timesheet, message: local_assigns[:message] %>
    <%= render "shared/form_header", title: "Edit Timesheet for project #{@timesheet.project.name}", subtitle: "Please update details of timesheet" %>
    <%= form.hidden_field :project_id, value: @timesheet.project.id %>
    <div>
      <label for="date" class="form-label">
        Date
      </label>
      <%= form.date_field :date, class: "form-text-field mt-1", value: @timesheet.date %>
    </div>
    <%= render Ui::FormFieldComponent.new(label: "Task Description", for_id: "timesheet_description") do %>
      <%= form.text_area :description, class: "resize-y form-text-field h-20" %>
    <% end %>
    <%= render Ui::FormFieldComponent.new(label: "Output", for_id: "timesheet_output") do %>
      <%= form.text_area :output, class: "resize-y form-text-field h-20" %>
    <% end %>
    <div>
      <label for="hours" class="form-label">
        Hours
      </label>
      <%= form.text_field :hours, class: "form-text-field mt-1", placeholder: "Time spent in hours", autocomplete: "off" %>
    </div>
    <div class="flex justify-end mt-6">
      <%= render Ui::BackButtonComponent.new() %>
      <%= render Ui::SubmitButtonComponent.new(form, "Edit Timesheet", class: "ml-2") %>
    </div>
  <% end %><% end %>

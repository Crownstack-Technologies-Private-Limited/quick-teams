<%= render Ui::TabsComponent.new(id: "employee-tabs") do |tabs| %>
  <% if policy([employee, Timeline]).index? %>
  <% tabs.with_tab("Timeline", employee_timeline_path) %>
  <% end %>
  <% if policy([employee, Team]).index? %>
  <% tabs.with_tab("Team", employee_team_path) %>
  <% end %>
  <% if policy([employee, Schedule]).index? %>
  <% tabs.with_tab("Schedules", employee_schedules_path) %>
  <% end %>
  <% if policy([employee, Feedback]).index? %>
  <% tabs.with_tab("Feedbacks", employee_feedbacks_path) %>
  <% end %>
  <% if policy([employee, Goal]).index? %>
  <% tabs.with_tab("Goals", employee_goals_path) %>
  <% end %>
  <% if policy([employee, Todo]).index? %>
  <% tabs.with_tab("Todos", employee_todos_path) %>
  <% end %>
  <% if policy([employee, Timesheet]).index? %>
  <% tabs.with_tab("Timesheets", employee_timesheets_path) %>
  <% end %>
  <% if policy([employee, Skill]).index? %>
  <% tabs.with_tab("Skills", employee_skills_path) %>
  <% end %>
  <% if policy([employee, Document]).index? %>
  <% tabs.with_tab("Documents", employee_documents_path) %>
  <% end %>
  <% if policy([employee, :survey]).index? %>
  <% tabs.with_tab("Surveys", employee_surveys_path) %>
  <% end %>
  <% if policy([employee, :kpi]).index? %>
  <% tabs.with_tab("KPIs", employee_kpis_path) %>
  <% end %>
  <% if policy([employee, :report]).index? %>
  <% tabs.with_tab("Reports", employee_reports_path) %>
  <% end %>
  <% if policy([employee, :about]).index? %>
  <% tabs.with_tab("About", employee_about_index_path) %>
  <% end %>
<% end %>

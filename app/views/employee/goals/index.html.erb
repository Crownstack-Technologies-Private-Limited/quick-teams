<%= render Ui::PageComponent.new do %>
  <%= render "employee/title", employee: @employee %>
  <%= render Ui::SplitLayoutComponent.new(inset: false) do |layout| %>
    <% layout.with_primary(data: { "controller": "infinite-scroll" }) do %>
      <section aria-labelledby="participants_section">
        <div class="w-full overflow-hidden">
          <%= render Ui::TableComponent.new(body_options: { id: "goals", data: { "infinite-scroll-target": "entries" } }) do |table| %>
            <% table.with_column("Goal", class: "w-full") %>
            <% table.with_column("Status", class: "px-6") %>
            <% table.with_column("Added by", class: "px-6") %>
            <% table.with_column("ADDED ON") %>
            <% table.with_column("Action") %>
            <%= render partial: "goal", collection: @goals, cached: false %>
          <% end %>
          <%= render Ui::PaginationComponent.new(@pagy, class: "invisible", data: { "infinite-scroll-target": "pagination" }) %>
        </div>
      </section>

    <% end %>
    <% if policy([@employee, Goal]).create? %>
      <% layout.with_secondary do %>
        <section aria-labelledby="add-participant-section">
          <div class="overflow-hidden bg-white">
            <div class="px-4">
              <%= render partial: "employee/goals/form", locals: { goal: @goal } %>
            </div>
          </div>
        </section>

      <% end %>
    <% end %>
  <% end %>
  <div class="pt-4 pl-16 pr-16">
  </div>
<% end %>

<%= render Ui::PageComponent.new do %>
  <%= render partial: "employee/title", locals: { employee: @employee } %>
  <%= render Ui::SplitLayoutComponent.new(inset: false) do |layout| %>
    <% layout.with_primary do %>
      <section aria-labelledby="participants_section">
        <div class="overflow-hidden bg-white">
          <div class="w-full overflow-hidden" data-controller="infinite-scroll">
            <%= render Ui::TableComponent.new(body_options: { id: "documents", data: { "infinite-scroll-target": "entries" } }) do |table| %>
              <% table.with_column("Document", class: "w-full") %>
              <% table.with_column("Added by", class: "px-6") %>
              <% table.with_column("ADDED ON") %>
              <% table.with_column("Action") %>
              <%= render partial: "document", collection: @documents, as: :document, cached: false %>
            <% end %>
            <%= render Ui::PaginationComponent.new(@pagy, class: "invisible", data: { "infinite-scroll-target": "pagination" }) %>
          </div>
        </div>
      </section>

    <% end %>
    <% if policy([@employee, Document]).create? %>
      <% layout.with_secondary do %>
        <section aria-labelledby="add-participant-section">
          <h2 class="sr-only" id="section-2-title">Add New document</h2>
          <div class="overflow-hidden bg-white">
            <div class="px-4">
              <%= render partial: "form", locals: { document: @document } %>
            </div>
          </div>
        </section>

      <% end %>
    <% end %>
  <% end %>
  <div class="pt-4 pl-16 pr-16">
  </div>
<% end %>

<%= render Ui::ModalComponent.new(dismissible: false, size: :sm) do %>
  <div>
    <div class="mx-auto flex items-center justify-center h-12 w-12 rounded-full bg-green-100">
      <%= render Ui::IconComponent.new(:check, class: "h-6 w-6 text-green-600") %>
    </div>
    <div class="mt-3 text-center sm:mt-5">
      <h3 class="text-lg leading-6 font-medium text-gray-900" id="modal-title">Payment successful</h3>
      <div class="mt-2">
        <p class="text-sm text-gray-500">Thanks for the subscription, <%= @customer.name %>!</p>
      </div>
    </div>
  </div>
  <div class="mt-5 sm:mt-6">
    <%= render Ui::ButtonComponent.new("Go Back to Dashboard", href: home_path, class: "inline-flex justify-center w-full") %>
  </div>
<% end %>

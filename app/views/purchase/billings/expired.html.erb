<%= render Ui::ModalComponent.new(dismissible: false, size: :sm) do %>
  <div>
    <div class="mx-auto flex items-center justify-center h-12 w-12 rounded-full">
      <%= render Ui::IconComponent.new(:x_circle, class: "ml-2 h-12 w-12 text-red-600") %>
    </div>
    <div class="text-center">
      <h3 class="text-lg leading-6 font-medium text-gray-900" id="modal-title">No Active Subscription</h3>
      <div class="mt-2">
        <p class="text-sm text-gray-500">This account has been suspended as there is no active subscription present. </p>
      </div>
    </div>
  </div>
  <% if current_user.account.owner == current_user %>
    <div class="mt-4 flex justify-center">
      <%= form_tag purchase_checkouts_path, method: :post, data: { turbo: false } do %>
        <input type="hidden" name="price_id" value="<%= Rails.application.credentials.dig(:stripe, :pricing, :monthly) %>" />
        <%= render Ui::ButtonComponent.new("Subscribe for $49/month", type: "submit") %>
      <% end %>
    </div>
  <% else %>
    <p class="text-sm text-gray-500 mt-4 text-center">Please contact your account owner to resolve this issue. </p>
  <% end %>
  <div class="mt-2">
    <a><%= link_to "Sign Out", destroy_user_session_path, data: { "turbo-method": :delete }, class: "block px-4 py-2 text-sm font-medium text-indigo-600 hover:text-indigo-500 hover:underline text-center", role: "menuitem" %></a>
  </div>
<% end %>

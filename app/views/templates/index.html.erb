<%= render Ui::PageComponent.new(tag: :div) do %>
  <%= render Ui::PageHeaderComponent.new(title: "Templates", subtitle: "(" + @templates.count.to_s + " Templates)") do |header| %>
    <% if current_user.admin? || current_user.lead? %>
      <% header.with_actions do %>
        <%= render Ui::ButtonComponent.new("New Template", href: new_template_path) %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
<div class="flex w-full overflow-hidden bg-white">
  <div class="flex w-full">
    <div class="w-full overflow-hidden" data-controller="infinite-scroll">
      <% if @templates.size > 0 %>
        <%= render Ui::TableComponent.new(body_options: { id: "templates", data: { "infinite-scroll-target": "entries" } }) do |table| %>
          <% table.with_column("Template", class: "w-full") %>
          <% table.with_column("Created At") %>
          <% table.with_column("Created by") %>
          <%= render partial: "template", collection: @templates, as: :template, cached: true %>
        <% end %>
        <%= render Ui::PaginationComponent.new(@pagy, class: "invisible", data: { "infinite-scroll-target": "pagination" }) %>
      <% else %>
        <%= render partial: "shared/no_result_found", cached: true %>
      <% end %>
    </div>
  </div>
</div>

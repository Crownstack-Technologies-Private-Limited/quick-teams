<% attempt.survey.questions.order_by_category.each_with_index do |question, index| %>
  <tr class="bg-white ">
    <td class="table-cell">
      <%= index + 1 %></td>
    <td class="table-cell"><%= question.text.upcase_first %></td>
    <td class="table-cell"><%= question.marked_score(attempt).to_s %></td>
    <td class="table-cell">
      <% if question.marked_score(attempt) == 0 %>
        <%= render Ui::IconComponent.new(:alert_circle_16, class: "h-6 w-6 text-amber-500", label: "Needs attention") %>
      <% elsif question.marked_score(attempt) >= 7 %>
        <%= render Ui::IconComponent.new(:check_circle_16, class: "h-6 w-6 text-green-600", label: "Correct") %>
      <% elsif question.marked_score(attempt) >= 4 && question.marked_score(attempt) <= 6 %>
        <%= render Ui::IconComponent.new(:check_circle_16, class: "h-6 w-6 text-pink-500", label: "Partially correct") %>
      <% else %>
        <%= render Ui::IconComponent.new(:x_circle_16, class: "h-6 w-6 text-red-600", label: "Incorrect") %>
      <% end %>
    </td>
  </tr>
<% end %>

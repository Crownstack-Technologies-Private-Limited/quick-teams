<main class="relative z-0 flex-1 focus:outline-none">
  <%= render "survey/title", survey: @survey %>
  <%= render Ui::SplitLayoutComponent.new(inset: false) do |layout| %>
    <% layout.with_primary do %>
      <section aria-labelledby="participants_section">
        <div class="overflow-hidden bg-white">
          <div id="employee-assignees" class="flex  flex-wrap " data-controller="infinite-scroll">
            <%= render Ui::TableComponent.new(body_options: { id: "assignees", data: { "infinite-scroll-target": "entries" } }) do |table| %>
              <% table.with_column("assignee", class: "w-full") %>
              <% table.with_column("Action") %>
              <%= render partial: "assignee", collection: @assignees, as: :assignee, cached: false %>
            <% end %>
            <%= render Ui::PaginationComponent.new(@pagy, class: "invisible", data: { "infinite-scroll-target": "pagination" }) %>
          </div>
        </div>
      </section>

    <% end %>
    <% layout.with_secondary do %>
      <%= render partial: "form", locals: { assigns: @assigns, survey: @survey } %>

    <% end %>
  <% end %>
</main>

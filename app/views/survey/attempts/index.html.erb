<main class="relative z-0 flex-1 focus:outline-none">
  <%= render "survey/title", survey: @survey %>
  <main class="pb-8">
    <div class="" id="assignees">
      <div class="grid items-start grid-cols-1 lg:grid-cols-3 ">
        <!-- Left column -->
        <div class="grid grid-cols-1 lg:col-span-2" >
          <section aria-labelledby="participants_section">
            <div class="overflow-x-auto bg-white">
              <div class="bg-white" data-controller="infinite-scroll">
                <div>
                  <%= render Ui::TableComponent.new(body_options: { id: "filled_surveys", data: { "infinite-scroll-target": "entries" } }) do |table| %>
                    <% table.with_column("Participant") %>
                    <% table.with_column("Taken By") %>
                    <% table.with_column("On Date") %>
                    <% table.with_column("Score") %>
                    <% table.with_column("Status") %>
                    <% table.with_column("Action") %>
                    <%= render partial: "attempt", collection: @attempts, as: :attempt, cached: true %>
                  <% end %>
                  <%= render Ui::PaginationComponent.new(@pagy, class: "invisible", data: { "infinite-scroll-target": "pagination" }) %>
                </div>
              </div>
            </div>
          </section>
          <div class="grid grid-cols-1 gap-4 xl:border-l xl:border-gray-200">
            <section aria-labelledby="add-participant-section">
              <div class="bg-white">
                <div class="px-4">
                  <%= render Ui::FormContainerComponent.new(class: "z-10") do %>
                  <% end %>
                </div>
              </div>
            </section>
          </div>
        </div>
      </div>
    </main>
  </main>

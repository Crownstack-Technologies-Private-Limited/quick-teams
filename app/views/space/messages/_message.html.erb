<% if policy([message.space, message]).show? %>
  <li class=" py-4 border-b border-gray-200 " id="<%= dom_id(message) %>">
    <% if message.published? %>
      <%= render Ui::TextLinkComponent.new(nil, space_message_path(message.space, message), tone: :plain) do %>
        <div class="flex flex-col ">
          <div class="flex justify-between">
            <div class="hover:underline inline-flex space-x-2">
              <h3 class="text-base font-medium line-clamp-1 flex-auto">
                <%= highlight_hashtag(message.title.upcase_first) %>
              </h3>
            </div>
          </div>
        </div>
      <% end %>
    <% else %>
      <%= render Ui::TextLinkComponent.new(nil, edit_space_message_path(message.space, message), tone: :plain) do %>
        <div class="flex flex-col " data-controller="swap" data-action="mouseenter->swap#mouseenter mouseleave->swap#mouseleave">
          <div class="flex justify-between">
            <div class="hover:underline inline-flex space-x-2">
              <h3 class="text-base font-medium line-clamp-1 flex-auto">
                <%= highlight_hashtag(message.title.upcase_first) %>
              </h3>
            </div>
            <div class="" data-swap-target="text">
              <%= render Ui::BadgeComponent.new("Draft", color: :red, class: "ml-2") %>
            </div>
          </div>
        </div>
      <% end %>
    <% end %>
    <span class="whitespace-nowrap text-gray-500 text-sm font-normal  flex-none">
      <%= message.user.decorate.display_name %> on <%= display_date(message.created_at) %>
    </span>
  </li>
<% end %>

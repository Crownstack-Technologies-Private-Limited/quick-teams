<!-- This example requires Tailwind CSS v2.0+ -->
<main class="max-w-4xl px-4 pt-10 pb-20 mx-auto  lg:pb-20" >
  <div class="px-4 py-4  sm:px-6 lg:px-8" id="message-header" >
    <%= render partial: "shared/messages/title", locals: { message: @message } %>
  </div>
  <% cache @message do %>
    <div class="text-sm  sm:px-6 lg:px-8 py-6 border-b border-gray-200  text-gray-700"  >
      <p class=""><%= @message.body %></p>
    </div>
  <% end %>
  <!-- Comments-->
  <section aria-labelledby="notes-title">
    <div class="bg-white sm:rounded-lg   ">
      <div class="relative h-max " data-controller="comments">
        <% display_comments = @comments.last(10) %>
        <% hidden_comments = @comments - display_comments %>
        <div   >
          <div class="relative py-6" id="load-comments">
            <div class="absolute inset-0 flex items-center" aria-hidden="true">
              <div class="w-full border-t border-gray-300"></div>
            </div>
            <div class="relative flex justify-center">
              <%= render Ui::ButtonComponent.new("Show older Comments", href: "#", variant: :secondary, size: :sm, class: "rounded-full", id: "toggle-old-comments", aria: { controls: "hidden-comments", expanded: "false" }, data: { action: "click->comments#toggleComments" }) %>
            </div>
          </div>
          <div id="hidden-comments" role="region" aria-labelledby="toggle-old-comments">
            <ul role="list">
              <%= render partial: "message_comments/hidden_comment", collection: hidden_comments, as: :comment, cached: false %>
            </ul>
          </div>
        </div>
        <ul role="list" class="relative z-0 divide-y divide-gray-200 " id="comments" >
          <%= render partial: "message_comments/message_comment", collection: display_comments, as: :comment, cached: false %>
        </ul>
      </div>
      <div  class="px-6" id="comment-form">
        <% if policy([@space, @message]).comment? %>
          <div >
            <%= render partial: "message_comments/new", locals: { space_message: @message, comment: @comment } %>
          </div>
        <% end %>
      </div>
    </div>
  </section>
</main>

<div class="fixed right-8 bottom-8 hidden flex-col gap-3 md:flex">
  <%= render Ui::ButtonComponent.new(variant: :icon, id: "scroll-top", "aria-label": "Scroll to top", class: "rounded-full bg-gray-200 p-2 text-gray-500 hover:bg-gray-300",
        data: { controller: "scroll-to", "scroll-to-target": "#message-header", action: "click->scroll-to#scroll" }) do %>
    <%= render Ui::IconComponent.new(:arrow_up, class: "w-6 h-6") %>
  <% end %>
  <%= render Ui::ButtonComponent.new(variant: :icon, id: "scroll-bottom", "aria-label": "Scroll to bottom", class: "rounded-full bg-gray-200 p-2 text-gray-500 hover:bg-gray-300",
        data: { controller: "scroll-to", "scroll-to-target": "#comment-form", action: "click->scroll-to#scroll" }) do %>
    <%= render Ui::IconComponent.new(:arrow_down, class: "w-6 h-6") %>
  <% end %>
</div>

<%= render Ui::FormContainerComponent.new(width: "max-w-4xl") do %>
  <div class="px-4">
    <%= tailwind_form_with(model: @document, id: dom_id(@document), url: project_document_path(@project, @document), method: :patch) do |form| %>
      <main class="w-full px-4 pt-6 pb-12 mx-auto space-y-4 lg:pb-16">
        <%= render "shared/form_messages", resource: @document, message: local_assigns[:message] %>
        <%= render "shared/form_header", title: "Edit Document for #{@project.name}", subtitle: "A project document can be link to project documentation, design files, project report or something project related" %>
        <%= form.text_field :filename, "Filename", autocomplete: "off" %>
        <div>
          <%= form.text_field :link, "Link", autocomplete: "off" %>
        </div>
        <%= form.text_area :comments, "Comments(optional)", class: "h-32 form-text-field", autocomplete: "off" %>
        <%= render Ui::FormActionsComponent.new do %>
          <%= render Ui::BackButtonComponent.new() %>
          <%= render Ui::SubmitButtonComponent.new(form, "Edit Document", class: "ml-2") %>
        <% end %>
      </main>
    <% end %>
  </div>
<% end %>

<%= form_with(model: document, id: dom_id(document), url: project_documents_path(@project)) do |form| %>
  <%= render Ui::FormContainerComponent.new do %>
    <%= render "shared/form_messages", resource: document, message: local_assigns[:message] %>
    <%= render "shared/form_header", title: "Add New Document", subtitle: "A project document can be link to project documentation, design files, project report or something project related" %>
    <div>
      <label for="filename" class="form-label">
        Filename
      </label>
      <%= form.text_field :filename, class: "form-text-field mt-1", autocomplete: "off" %>
    </div>
    <div>
      <label for="link" class="form-label">
        Link
      </label>
      <%= form.text_field :link, class: "form-text-field mt-1", autocomplete: "off" %>
    </div>
    <div>
      <label for="comments" class="form-label">
        Comments(optional)
      </label>
      <%= form.text_area :comments, class: "form-text-field mt-1", autocomplete: "off" %>
    </div>
    <div class="flex justify-end mt-6">
      <%= render Ui::SubmitButtonComponent.new(form, "Add Document") %>
    </div>
  <% end %>
<% end %>

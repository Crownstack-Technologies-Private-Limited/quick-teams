<!-- This example requires Tailwind CSS v2.0+ -->
<% @report = @report.decorate %>
<%= render Ui::FormContainerComponent.new(width: "max-w-4xl") do %>
  <div class="px-4 py-4 sm:flex sm:items-center sm:justify-between sm:px-6 lg:px-8"  id="report-detail">
    <div class="flex-1 min-w-0">
      <h3 class="text-xl font-semibold tracking-tight text-gray-900">
        <%= @report.display_title %>
      </h3>
      <div class="flex mt-4 space-x-3">
        <div class="flex-shrink-0">
          <% display_medium_avatar(@report.user) %>
        </div>
        <div>
          <div class="text-sm">
            <%= render Ui::TextLinkComponent.new(@report.reportable.decorate.display_name, project_reports_path(@report.reportable), tone: :strong) %>
          </div>
          <div class="mt-1 space-x-2 text-sm">
            <span class="font-medium text-gray-500"> Created On <%= display_created_at(@report) %> By <%= @report.user.display_name %></span>
          </div>
        </div>
      </div>
    </div>
    <div class="flex mt-4 sm:mt-0 sm:ml-4">
      <%= render Ui::BackButtonComponent.new() %>
    </div>
    <% if policy([@project, @report]).edit? %>
      <%= render Ui::ButtonComponent.new("Edit", href: edit_project_report_path(@report.reportable, @report), class: "ml-2") %>
    <% end %>
  </div>
  <% cache @report do %>
    <div class="mt-1 text-sm text-gray-700 sm:px-6 lg:px-8">
      <p><%= @report.body %></p>
    </div>
  <% end %>
  <div id="report-status-<%= @report.id %>">
    <%= render partial: "shared/reports/status", locals: { report: @report, show_submit_button: policy([@project, @report]).edit? } %>
  </div>
  <!-- Comments-->
  <section aria-labelledby="comments-title">
    <div class="pb-24 bg-white sm:rounded-lg overflow">
      <div class="divide-y divide-gray-200">
        <div class="px-4 py-5 sm:px-6">
          <h2 id="comments-title" class="text-lg font-medium text-gray-900">Comments</h2>
        </div>
        <div class="px-4 py-6 sm:px-6">
          <ul class="space-y-4" id="comments">
            <%= render partial: "shared/comments/comment", collection: @report.comments.includes(:user).order(created_at: :asc), as: :comment, cached: true %>
          </ul>
        </div>
      </div>
      <% if policy([@project, @report]).comment? %>
        <%= render partial: "shared/comments/report", locals: { report: @report, comment: @comment } %>
      <% end %>
    </div>
  </section>
<% end %>

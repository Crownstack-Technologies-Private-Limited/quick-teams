<%= render Ui::PageComponent.new do %>
  <%= render "project/title", project: @project %>
  <%= render Ui::SplitLayoutComponent.new(inset: false) do |layout| %>
    <% layout.with_primary(id: "report-list") do %>
      <section aria-labelledby="participants_section">
        <div class="overflow-hidden bg-white">
          <div class="w-full overflow-hidden" data-controller="infinite-scroll">
            <%= render Ui::TableComponent.new(body_options: { id: "reports", data: { "infinite-scroll-target": "entries" } }) do |table| %>
              <% table.with_column("Report", class: "w-full") %>
              <% table.with_column("Created By") %>
              <% table.with_column("Status") %>
              <% table.with_column("Created At") %>
              <% table.with_column("Action") %>
              <%= render partial: "project/reports/report", collection: @reports, cached: false %>
            <% end %>
            <%= render Ui::PaginationComponent.new(@pagy, class: "invisible", data: { "infinite-scroll-target": "pagination" }) %>
          </div>
        </div>
      </section>

    <% end %>
    <% if policy([@project, Report]).create? %>
      <% layout.with_secondary(id: "new_report") do %>
        <section aria-labelledby="add-participant-section">
          <div class="overflow-hidden bg-white pb-2">
            <p class="text-sm text-gray-500 mt-4 text-center p-2">
              A report can be anything about the project, for example, milestones updates or anything you want to share with your team.
            </p>
            <div class="justify-center flex ">
              <%= render Ui::ButtonComponent.new("Submit New Report", href: new_project_report_path(@project), class: "items-center mt-2 p-2") %>
            </div>
          </div>
        </section>

      <% end %>
    <% end %>
  <% end %>
  <div class="pt-4 pl-16 pr-16">
  </div>
<% end %>

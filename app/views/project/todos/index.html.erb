<%= render Ui::PageComponent.new do %>
  <%= render "project/title", project: @project %>
  <%= render Ui::SplitLayoutComponent.new(inset: false) do |layout| %>
    <% layout.with_primary(id: "todo-list") do %>
      <section aria-labelledby="participants_section">
        <div class="overflow-hidden bg-white">
          <div class="w-full overflow-hidden" data-controller="infinite-scroll">
            <%= render Ui::TableComponent.new(body_options: { id: "todos", data: { "infinite-scroll-target": "entries" } }) do |table| %>
              <% table.with_column("Done") %>
              <% table.with_column("Assigned") %>
              <% table.with_column("Title") %>
              <% table.with_column("Due Date") %>
              <% table.with_column("Action") %>
              <%= render partial: "project/todos/todo", collection: @todos, as: :todo, cached: true %>
            <% end %>
            <%= render Ui::PaginationComponent.new(@pagy, class: "invisible", data: { "infinite-scroll-target": "pagination" }) %>
          </div>
        </div>
      </section>

    <% end %>
    <% if policy([@project, Feedback]).show_add_feedback_form? %>
      <% layout.with_secondary do %>
        <section aria-labelledby="add-participant-section">
          <div class="overflow-hidden bg-white">
            <div class="px-4">
              <%= render partial: "project/todos/form", locals: { todo: @todo, errors: nil } %>
            </div>
          </div>
        </section>

      <% end %>
    <% end %>
  <% end %>
  <div class="pt-4 pl-16 pr-16">
  </div>
<% end %>

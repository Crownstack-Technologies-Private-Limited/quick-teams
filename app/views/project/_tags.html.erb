<% if project.project_tags.load.size > 0 %>
  <% project.project_tags.uniq.each do |tag| %>
    <%= render Ui::TagComponent.new(tag.name, color: tag.color, size: :sm, class: "ml-2",
          remove: { id: "remove", data: { reflex: "click->ProjectTags#remove", "tag-id": tag.id, "project-id": project.id } }) %>
  <% end %>
<% end %>

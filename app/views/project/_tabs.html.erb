<%= render Ui::TabsComponent.new(id: "project-tabs") do |tabs| %>
  <% if current_user.admin? %>
  <% tabs.with_tab("Timeline", project_timeline_path) %>
  <% end %>
  <% tabs.with_tab("Schedules", project_schedules_path) %>
  <% tabs.with_tab("Notes", project_notes_path) %>
  <% tabs.with_tab("Risks", project_risks_path) %>
  <% tabs.with_tab("Feedbacks", project_feedbacks_path) %>
  <% tabs.with_tab("Milestones", project_milestones_path) %>
  <% tabs.with_tab("Todos", project_todos_path) %>
  <% tabs.with_tab("Timesheets", project_timesheets_path) %>
  <% tabs.with_tab("TechStack", project_skills_path) %>
  <% tabs.with_tab("Documents", project_documents_path) %>
  <% tabs.with_tab("Surveys", project_surveys_path) %>
  <% tabs.with_tab("Reports", project_reports_path) %>
  <% if current_user.admin? %>
  <% tabs.with_tab("Clients", project_clients_path) %>
  <% end %>
  <% if policy([@project, :about]).index? %>
  <% tabs.with_tab("About", project_about_index_path) %>
  <% end %>
<% end %>

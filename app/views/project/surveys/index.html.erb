<%= render Ui::PageComponent.new do %>
  <%= render "project/title", project: @project %>
  <%= render Ui::SplitLayoutComponent.new(inset: false) do |layout| %>
    <% layout.with_primary do %>
      <section aria-labelledby="participants_section">
        <div class="overflow-hidden bg-white" data-controller="infinite-scroll">
          <div>
            <%= render Ui::TableComponent.new(body_options: { id: "filled_surveys", data: { "infinite-scroll-target": "entries" } }) do |table| %>
              <% table.with_column("Survey", class: "w-full") %>
              <% table.with_column("Taken By") %>
              <% table.with_column("On Date") %>
              <% table.with_column("Score") %>
              <% table.with_column("Status") %>
              <% table.with_column("Action") %>
              <%= render partial: "filled_survey", collection: @filled_surveys, as: :attempt, cached: false %>
            <% end %>
            <%= render Ui::PaginationComponent.new(@pagy, class: "invisible", data: { "infinite-scroll-target": "pagination" }) %>
          </div>
        </div>
      </section>

    <% end %>
    <% layout.with_secondary do %>
      <% if policy([@project, :survey]).take? %>
        <section aria-labelledby="add-participant-section">
          <div class="overflow-hidden bg-white">
            <div class="px-4">
              <div class="p-5 border-b border-gray-200">
                <h3 class="text-lg leading-6 font-medium text-gray-900">
                  Take a Survey
                </h3>
                <p class="mt-2 max-w-4xl text-sm text-gray-500">Following surveys are available for you to take. </p>
              </div>
              <ul class="divide-y divide-gray-200">
                <%= render partial: "survey", collection: @surveys, as: :survey, cached: false %>
              </ul>
            </div>
          </div>
        </section>
      <% end %>

    <% end %>
  <% end %>
  <div class="pt-4 pl-16 pr-16">
  </div>
<% end %>

<%= render Ui::PageComponent.new do %>
  <%= render partial: "project/title", locals: { project: @project } %>
  <%= render Ui::SplitLayoutComponent.new do |layout| %>
    <% layout.with_primary(id: "project_notes", data: { "controller": "infinite-scroll" }) do %>
      <section aria-labelledby="participants_section">
        <h2 class="sr-only" id="section-1-title">Project Notes</h2>
        <div class="overflow-hidden bg-white" >
          <div class="p-4">
            <div class="flex flex-wrap">
              <p class="mt-1 text-sm font-medium text-gray-900 truncate"><%= "Project Notes" %></p>
            </div>
            <ul class="space-y-4" id="notes" data-infinite-scroll-target="entries">
              <%= render partial: "note", collection: @notes, as: :note, cached: true %>
            </ul>
          </div>
        </div>
        <%= render Ui::PaginationComponent.new(@pagy, class: "invisible", data: { "infinite-scroll-target": "pagination" }) %>
      </section>

    <% end %>
    <% if policy([@project, Note]).create? %>
      <% layout.with_secondary do %>
        <section aria-labelledby="add-participant-section">
          <h2 class="sr-only" id="section-2-title">Add New Note</h2>
          <div class="overflow-hidden bg-white">
            <div class="px-4">
              <%= render partial: "project/notes/form", locals: { note: @note } %>
            </div>
          </div>
        </section>

      <% end %>
    <% end %>
  <% end %>
  <div class="pt-4 pl-16 pr-16">
  </div>
<% end %>

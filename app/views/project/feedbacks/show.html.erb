<% cache @feedback do %>
  <!-- This example requires Tailwind CSS v2.0+ -->
  <%= render Ui::FormContainerComponent.new(width: "max-w-4xl") do %>
    <div class="px-4 py-4 sm:flex sm:items-center sm:justify-between sm:px-6 lg:px-8" id="feedback-detail">
      <div class="flex-1 min-w-0">
        <h3 class="text-xl font-semibold tracking-tight text-gray-900">
          <%= @feedback.title %>
        </h3>
        <div class="flex mt-4 space-x-3">
          <div class="flex-shrink-0">
            <% display_medium_avatar(@feedback.user) %>
          </div>
          <div>
            <div class="text-sm">
              <%= render Ui::TextLinkComponent.new(@feedback.critiquable.name, project_feedbacks_path(@project), tone: :strong) %>
            </div>
            <div class="mt-1 space-x-2 text-sm">
              <span class="font-medium text-gray-500">Created By <%= @feedback.user.decorate.display_name %> on <%= display_created_at(@feedback) %></span>
            </div>
          </div>
        </div>
      </div>
      <div class="flex mt-4 sm:mt-0 sm:ml-4">
        <%= render Ui::BackButtonComponent.new() %>
      </div>
    </div>
    <div class="mt-1 text-sm text-gray-700 sm:px-6 lg:px-8">
      <p><%= @feedback.body %></p>
    </div>
  <% end %>
<% end %>

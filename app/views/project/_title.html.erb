<% project = project.decorate %>
<%= render Ui::PageHeaderComponent.new(title: project.name.titleize, subtitle: project.display_discipline, bordered: false, id: "project-header") do |header| %>
  <% if current_user.admin? %>
    <% header.with_meta do %>
      <div class="flex">
        <div id="project-tags" class="flex ml-4">
          <%= render partial: "project/tags", locals: { project: project, tags: project.project_tags } %>
        </div>
        <%= render Ui::DropdownComponent.new(button_id: "add", label: "Add tag", button_variant: :plain, chevron: false, wrapper_class: "mr-4",
              button_class: "inline-flex items-center p-1 ml-2 text-primary-700 bg-primary-50 border border-primary-200 rounded-full hover:bg-primary-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-primary-500") do |menu| %>
          <% menu.with_trigger { render Ui::IconComponent.new(:plus, class: "w-4 h-4") } %>
          <% if @tags.empty? %>
            <p role="menuitem" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">No project tag added yet</p>
            <%= link_to "Add Project Tags", account_project_tags_path, class: "block px-4 py-2 text-sm text-primary-700 hover:bg-gray-50 hover:underline" %>
          <% else %>
            <% @tags.uniq.each do |tag| %>
              <% menu.with_item(tag.name, "#", data: { reflex: "click->ProjectTags#change", "project-id": project.id, "tag-id": tag.id }) %>
            <% end %>
          <% end %>
        <% end %>
      </div>
    <% end %>
    <% header.with_actions do %>
      <div id="project-status" class="flex">
        <%= render partial: "project/status", locals: { project: project } %>
      </div>
      <%= render Ui::DropdownComponent.new(button_id: "menu-button", wrapper_class: "mr-2") do |menu| %>
        <% menu.with_trigger { "Status" } %>
        <% if @statuses.empty? %>
          <p role="menuitem" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">No project status added yet</p>
          <%= link_to "Add Project Status", account_project_statuses_path, class: "block px-4 py-2 text-sm text-primary-700 hover:bg-gray-50 hover:underline" %>
        <% else %>
          <% @statuses.each do |status| %>
            <% menu.with_item(status.name, "#", data: { reflex: "click->ProjectStatus#change", "project-id": project.id, "status-id": status.id }) %>
          <% end %>
        <% end %>
      <% end %>
      <div>
        <%= render Ui::ButtonComponent.new("Edit", href: edit_project_path(project), variant: :secondary) %>
      </div>
      <div>
        <% if !project.archived %>
          <%= confirm_button(archive_project_path(project), "Archive", "Are you sure?", "ml-2 btn-secondary") %>
        <% else %>
          <%= confirm_button(unarchive_project_path(project), "Restore", "Are you sure?", "ml-2 btn-secondary") %>
        <% end %>
      </div>
    <% end %>
  <% end %>
<% end %>
<% if current_user.admin? %>
  <% if project.manager.nil? %>
    <p class="px-6 -mt-2 text-sm font-medium text-gray-500 truncate"><%= project.description %> No Project manager has been assigned to this project yet. This is a <%= project.billable? ? "billable" : "Non billable" %> project.</p>
  <% else %>
    <p class="px-6 -mt-2 text-sm font-medium text-gray-500 truncate"><%= project.description %> This is a <%= project.billable? ? "billable" : "Non billable" %> project and is managed by <%= project.manager.decorate.display_name %>.</p>
  <% end %>
<% end %>
<%= render "project/tabs" %>

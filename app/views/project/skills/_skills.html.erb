<% skills.uniq.each do |skill| %>
  <%= render Ui::TagComponent.new(color: "gray", size: :md, class: "ml-2 mb-2",
        remove: { id: "remove-skill", data: { reflex: "click->ProjectSkills#remove", "skill-id": skill.id, "project-id": project.id } }) do %>
    <% if user.admin? %>
      <a href="<%= skills_reports_path(ids: skill.id, script_name: "/#{user.account.id}") %>" class="hover:underline whitespace-nowrap">
        <%= skill.name %>
      </a>
    <% else %>
      <%= skill.name %>
    <% end %>
  <% end %>
<% end %>

<main class="relative z-0 flex-1 overflow-y-auto focus:outline-none">
  <%= render partial: "project/title", locals: { project: @project } %>
  <main class="pb-8">
    <div class="">
      <!-- Main 3 column grid -->
      <div class="grid items-start grid-cols-1 lg:grid-cols-3">
        <!-- Left column -->
        <div class="grid grid-cols-1 gap-4 lg:col-span-2" id="todo-list">
          <section aria-labelledby="participants_section">
            <div class="overflow-hidden bg-white">
              <div class="w-full overflow-hidden" data-controller="infinite-scroll">
                <%= render Ui::TableComponent.new(body_options: { id: "risks", data: { "infinite-scroll-target": "entries" } }) do |table| %>
                  <% table.with_column("Risk") %>
                  <% table.with_column("Added by") %>
                  <% table.with_column("created_at") %>
                  <% table.with_column("Action") %>
                  <%= render partial: "risk", collection: @risks, as: :risk, cached: true %>
                <% end %>
                <div class="flex justify-end invisible mt-2 mb-6 mr-2" data-infinite-scroll-target="pagination">
                  <%== render partial: "shared/paginator", locals: { pagy: @pagy } %>
                </div>
              </div>
            </div>
          </section>
        </div>
        <!-- Right column -->
        <% if policy([@project, Risk]).create? %>
          <div class="grid grid-cols-1 gap-4 xl:border-l xl:border-gray-200">
            <section aria-labelledby="add-participant-section">
              <h2 class="sr-only" id="section-2-title">Add New risk</h2>
              <div class="overflow-hidden bg-white">
                <div class="px-4">
                  <%= render partial: "project/risks/form", locals: { risk: @risk } %>
                </div>
              </div>
            </section>
          </div>
        <% end %>
      </div>
    </div>
  </main>
  <div class="pt-4 pl-16 pr-16">
  </div>
</main>

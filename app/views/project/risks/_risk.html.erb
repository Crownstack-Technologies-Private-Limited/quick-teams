<tr  id="<%= dom_id risk %>">
  <td class=" w-full table-cell">
    <div class="space-x-2 inline-flex">
      <div class="flex">
        <% if risk.status? %>
          <%= render Ui::IconComponent.new(:exclamation_circle, class: "h-5 w-5 text-#{risk.decorate.risk_status_color}-700") %>
        <% else %>
          <%= render Ui::IconComponent.new(:check_circle, class: " flex-shrink-0 h-5 w-5 text-green-400") %>
        <% end %>
      </div>
      <div class="flex">
        <p class="whitespace-pre-wrap"><%= risk.body.upcase_first %></p>
      </div>
    </div>
  </td>
  <td class="table-cell whitespace-nowrap">
    <a href="#" class="font-medium text-gray-900"><%= risk.user.decorate.display_name %></a>
  </td>
  <td class="table-cell whitespace-nowrap">
    <span class="font-medium text-gray-500"><%= display_created_at(risk) %></span>
  </td>
  <td class="table-cell whitespace-nowrap">
    <div class="space-x-2 inline-flex">
      <% if policy([@project, risk]).edit? %>
        <% if risk.status? %>
          <%= render Ui::ButtonComponent.new("Mitigate", href: project_risk_path(@project, risk), variant: :inline_edit, data: { "turbo-method": :patch }) %>
        <% else %>
          <%= render Ui::ButtonComponent.new("Reopen", href: project_risk_path(@project, risk), variant: :inline_edit, data: { "turbo-method": :patch }) %>
        <% end %>
        <%= delete_button(project_risk_path(@project, risk)) %>
      <% end %>
    </div>
  </td>
</div>
</div>
</tr>

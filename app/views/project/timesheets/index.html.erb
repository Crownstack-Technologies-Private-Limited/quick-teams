<%= render Ui::PageComponent.new do %>
  <%= render partial: "project/title", locals: { project: @project } %>
  <%= render Ui::SplitLayoutComponent.new(inset: false) do |layout| %>
    <% layout.with_primary(id: "timesheet-list") do %>
      <% if @timesheets.size > 0 %>
        <section aria-labelledby="participants_section">
          <div class="overflow-hidden bg-white" >
            <div class="w-full overflow-hidden" data-controller="infinite-scroll">
              <%= render Ui::TableComponent.new(body_options: { data: { "infinite-scroll-target": "entries" } }) do |table| %>
                <% table.with_column("Employee") %>
                <% table.with_column("Task") %>
                <% table.with_column("Date") %>
                <% table.with_column("Hours") %>
                <% table.with_column("Action") %>
                <%= render partial: "project/timesheets/timesheet", collection: @timesheets, cached: false %>
              <% end %>
              <p class="pr-4 mt-2 text-sm text-right text-gray-500">Showing last 30 days' timesheets only.</p>
              <%= render Ui::PaginationComponent.new(@pagy, class: "invisible", data: { "infinite-scroll-target": "pagination" }) %>
            </div>
          </div>
        <% end %>
      </section>

    <% end %>
    <% layout.with_secondary(id: "timesheet-stats") do %>
      <section aria-labelledby="add-participant-section">
        <div class="overflow-hidden bg-white">
          <div class="px-4">
            <div class="flex justify-center mt-4" data-project-id="<%= @project.id %>">
              <%= render Ui::ButtonGroupComponent.new do |group| %>
  <% group.with_button("Last Week", data: { reflex: "click->ProjectTimesheetsStats#last_week", "reflex-dataset": "combined" }) %>
  <% group.with_button("Last Month", data: { reflex: "click->ProjectTimesheetsStats#last_month", "reflex-dataset": "combined" }) %>
<% end %>
            </div>
            <div id="stats">
              <%= render partial: "project/timesheets/stats", locals: { project_stats: @project_timesheets_stats, title: @project_timesheets_stats.title }, cached: true %>
            </div>
          </div>
        </div>
      </section>

    <% end %>
  <% end %>
  <div class="pt-4 pl-16 pr-16">
  </div>
<% end %>

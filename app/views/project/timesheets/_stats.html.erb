<div class="flex flex-wrap p-4">
  <% if current_user.admin? %>
    <!-- Somehow normal rails path are not working in stimulus reflex render so putting this hack -->
    <a
      class="w-full hover:underline"
      href="<%= "/" + Current.account.id.to_s + "/report/timesheets?" + "project_id=" + project_stats.project.id.to_s + "&from_date=" + project_stats.from_date.to_s + "&to_date=" + project_stats.to_date.to_s %>"
    >
      <p class="text-sm font-medium text-gray-900">
        <%= project_stats.title %>
      </p>
    </a>
  <% else %>
    <p class="text-sm font-medium text-gray-900"><%= project_stats.title %></p>
  <% end %>
</div>

<div>
  <dl class="grid grid-cols-1 gap-5 sm:grid-cols-3">
    <%= render Ui::StatCardComponent.new(label: "Total Hours", value: project_stats.stats.total_hours, variant: :plain) %>
    <%= render Ui::StatCardComponent.new(label: "Billable Hours", value: project_stats.stats.billable_hours, variant: :plain) %>
    <%= render Ui::StatCardComponent.new(label: "Billed Hours", value: project_stats.stats.billed_hours, variant: :plain) %>
  </dl>
</div>

<div class="flex flex-wrap px-4 mt-6">
  <p class="text-sm font-medium text-gray-900 truncate">
    <%= "Top Contributors" %>
  </p>
</div>

<ul class="divide-y divide-gray-200">
  <% project_stats.contributors.each do |contributor| %>
    <li class="flex px-2 py-2">
      <% if current_user.admin? %>
        <!-- Somehow normal rails path are not working in stimulus reflex render so putting this hack -->
        <a
          class="w-full hover:underline"
          href="<%= "/" + Current.account.id.to_s + "/report/timesheets?" + "project_id=" + project_stats.project.id.to_s + "&user_id=" + contributor.employee.id.to_s + "&from_date=" + project_stats.from_date.to_s + "&to_date=" + project_stats.to_date.to_s %>"
        >
          <div class="w-full ml-3">
            <p class="text-sm font-medium text-gray-500">
              <%= contributor.display_name.titleize %>
            </p>
          </div>
        </a>
      <% else %>
        <div class="w-full ml-3">
          <p class="text-sm font-medium text-gray-500">
            <%= contributor.display_name.titleize %>
          </p>
        </div>
      <% end %>
      <div class="w-full ml-3">
        <p class="text-sm font-medium text-right text-gray-500">
          <%= contributor.contribution.titleize %>
        </p>
      </div>
    </li>
  <% end %>
</ul>

<%= turbo_frame_tag dom_id(@project) do %>
  <%= form_with(model: @project, id: dom_id(@project), url: project_update_path(@project)) do |form| %>
    <main class="pb-12 py-6 lg:pb-16 space-y-4">
      <div class="px-4">
        <div class="w-full">
          <h1 class="text-lg leading-6 font-medium text-gray-900">
            Edit About for <%= @project.decorate.display_name %>
          </h1>
          <%= form.text_area :about, class: "form-text-field h-48 mt-2" %>
        </div>
        <div class="flex justify-end mt-4">
          <div class="ml-1">
            <%= render Ui::SubmitButtonComponent.new(form, "Save", class: "justify-end") %>
          </div>
          <div class="ml-1">
            <%= render Ui::ButtonComponent.new("Cancel", href: project_about_index_path, variant: :secondary) %>
          </div>
        </div>
      </div>
    </main>
  <% end %>
<% end %>

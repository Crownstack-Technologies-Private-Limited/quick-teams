  <%= tailwind_form_with(model: project_tag, id: dom_id(project_tag), url: account_project_tags_path) do |form| %>
  <div class="space-y-4">
    <%= render "shared/form_messages", resource: project_tag, message: local_assigns[:message] %>
    <%= render "shared/form_header", title: "Project Tags", subtitle: "You can define custom tags which can be applied to your projects. Examples include At Risk, In UAT." %>
    <%= form.text_field :name, "Add New Tag", autocomplete: "off" %>
    <!-- this is a hack to complile colors -->
    <div class="bg-gray-400 hover:bg-gray-200"></div>
    <div class="bg-red-400 hover:bg-red-200"></div>
    <div class="bg-yellow-400 hover:bg-yellow-200"></div>
    <div class="bg-green-400 hover:bg-green-200"></div>
    <div class="bg-blue-400 hover:bg-blue-200"></div>
    <!-- Hack ends here -->
    <div class="flex flex-wrap items-center gap-y-2">
      <label for="project_tag_color" class="text-sm">Appearance</label>
      <%= render Ui::ColorPickerComponent.new(name: "project_tag[color]", selected: "gray", id_prefix: "new_project_tag") %>
    </div>
    <div class="flex justify-end">
      <%= render Ui::SubmitButtonComponent.new(form, "Save") %>
    </div>
  </div>
<% end %>

<%= turbo_frame_tag dom_id(project_tag) do %>
  <%= render Ui::ListRowComponent.new(title: project_tag.name.titleize) do |row| %>
    <% row.with_leading { render Ui::StatusDotComponent.new(color: project_tag.color, class: "flex-shrink-0", "aria-hidden": "true") } %>
    <% row.with_actions do %>
      <%= edit_button(edit_account_project_tag_path(project_tag)) %>
      <%= delete_button(account_project_tag_path(project_tag)) %>
    <% end %>
  <% end %>
<% end %>

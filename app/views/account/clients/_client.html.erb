<%= turbo_frame_tag dom_id(client) do %>
  <%= render Ui::ListRowComponent.new(title: client.name.titleize, subtitle: client.email) do |row| %>
    <% row.with_leading { image_tag "male-placeholder-image.png", class: "w-10 h-10 rounded-full", alt: "" } %>
    <% row.with_actions do %>
      <%= edit_button(edit_account_client_path(client)) %>
      <%= delete_button(account_client_path(client)) %>
    <% end %>
  <% end %>
<% end %>

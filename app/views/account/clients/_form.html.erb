  <%= form_with(model: client, id: dom_id(client), url: account_clients_path) do |form| %>
  <div class="space-y-4">
    <%= render "shared/form_messages", resource: client, message: local_assigns[:message] %>
    <%= render "shared/form_header", title: "Client", subtitle: "You can add your clients here. These clients can be assigned to projects." %>
    <div>
      <label for="project_name" class="form-label">
        Add New Client
      </label>
      <div class="flex w-full mt-1 mb-8">
        <%= form.text_field :name, placeholder: "Full Name", class: "form-text-field", autocomplete: "off" %>
        <%= form.text_field :email, placeholder: "Email", class: "ml-3 form-text-field", autocomplete: "off" %>
        <%= render Ui::SubmitButtonComponent.new(form, "Save", class: "ml-2 justify-end") %>
      </div>
    </div>
  </div>
<% end %>

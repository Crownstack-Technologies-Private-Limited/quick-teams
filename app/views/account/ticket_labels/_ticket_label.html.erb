<%= turbo_frame_tag dom_id(ticket_label) do %>
  <%= render Ui::ListRowComponent.new(title: ticket_label.name.titleize, subtitle: "#{ticket_label.discipline.name.titleize} · #{ticket_label.user.decorate.display_name.titleize}") do |row| %>
    <% row.with_actions do %>
      <%= edit_button(edit_account_ticket_label_path(ticket_label)) %>
      <%= delete_button(account_ticket_label_path(ticket_label)) %>
    <% end %>
  <% end %>
<% end %>

<%= turbo_frame_tag dom_id(people_tag) do %>
  <%= render Ui::ListRowComponent.new(title: people_tag.name.titleize) do |row| %>
    <% row.with_leading { render Ui::StatusDotComponent.new(color: people_tag.color, class: "flex-shrink-0", "aria-hidden": "true") } %>
    <% row.with_actions do %>
      <%= edit_button(edit_account_people_tag_path(people_tag)) %>
      <%= delete_button(account_people_tag_path(people_tag)) %>
    <% end %>
  <% end %>
<% end %>

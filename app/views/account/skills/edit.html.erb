<%= turbo_frame_tag dom_id(@skill) do %>
  <%= form_with(model: @skill, id: dom_id(@skill), url: account_skill_path(@skill)) do |form| %>
    <%= render Ui::InlineErrorsComponent.new(local_assigns[:messages]) %>
    <li class="flex w-full py-4 border-b border-gray-200">
      <div class="w-full">
        <%= form.text_field :name, class: "form-text-field", autocomplete: "off" %>
      </div>
      <div class="flex">
        <%= render Ui::SubmitButtonComponent.new(form, "Save", class: "ml-2") %>
      </div>
    </li>
  <% end %>
<% end %>

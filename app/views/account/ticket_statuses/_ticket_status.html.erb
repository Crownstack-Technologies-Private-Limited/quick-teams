<%= turbo_frame_tag dom_id(ticket_status) do %>
  <%= render Ui::ListRowComponent.new(title: ticket_status.name.titleize) do |row| %>
    <% row.with_leading { render Ui::StatusDotComponent.new(color: ticket_status.color, class: "flex-shrink-0", "aria-hidden": "true") } %>
    <% row.with_actions do %>
      <%= edit_button(edit_account_ticket_status_path(ticket_status)) %>
      <%= delete_button(account_ticket_status_path(ticket_status)) %>
    <% end %>
  <% end %>
<% end %>

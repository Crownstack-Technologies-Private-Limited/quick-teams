<%= turbo_frame_tag dom_id(people_status) do %>
  <%= render Ui::ListRowComponent.new(title: people_status.name.titleize) do |row| %>
    <% row.with_leading { render Ui::StatusDotComponent.new(color: people_status.color, class: "flex-shrink-0", "aria-hidden": "true") } %>
    <% row.with_actions do %>
      <%= edit_button(edit_account_people_status_path(people_status)) %>
      <%= delete_button(account_people_status_path(people_status)) %>
    <% end %>
  <% end %>
<% end %>

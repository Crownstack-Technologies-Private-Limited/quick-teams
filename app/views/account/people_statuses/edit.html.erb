<%= turbo_frame_tag dom_id(@people_status) do %>
  <%= form_with(model: @people_status, id: dom_id(@people_status), url: account_people_status_path(@people_status)) do |form| %>
    <%= render Ui::InlineErrorsComponent.new(local_assigns[:messages]) %>
    <li class="flex w-full py-4 border-b border-gray-200">
      <div class="w-full">
        <%= form.text_field :name, class: "form-text-field", autocomplete: "off" %><br>
        <%= render Ui::ColorPickerComponent.new(name: "people_status[color]", selected: @people_status.color, id_prefix: "edit_people_status") %>
      </div>
      <div>
        <%= render Ui::SubmitButtonComponent.new(form, "Save", class: "ml-2") %>
      </div>
      <div>
      </div>
    </li>
  <% end %>
<% end %>

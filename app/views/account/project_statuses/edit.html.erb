<%= turbo_frame_tag dom_id(@project_status) do %>
  <%= form_with(model: @project_status, id: dom_id(@project_status), url: account_project_status_path(@project_status)) do |form| %>
    <%= render Ui::InlineErrorsComponent.new(local_assigns[:messages]) %>
    <li class="flex w-full py-4 border-b border-gray-200">
      <div class="w-full">
        <%= form.text_field :name, class: "form-text-field", autocomplete: "off" %><br>
        <%= render Ui::ColorPickerComponent.new(name: "project_status[color]", selected: @project_status.color, id_prefix: "edit_project_status") %>
      </div>
      <div>
        <%= render Ui::SubmitButtonComponent.new(form, "Save", class: "ml-2") %>
      </div>
      <div>
      </div>
    </li>
  <% end %>
<% end %>

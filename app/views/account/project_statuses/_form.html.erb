  <%= tailwind_form_with(model: project_status, id: dom_id(project_status), url: account_project_statuses_path) do |form| %>
  <div class="space-y-4">
    <%= render "shared/form_messages", resource: project_status, message: local_assigns[:message] %>
    <%= render "shared/form_header", title: "Project Status", subtitle: "You can define custom status which can be applied to your projects. Examples include tentative, in progess." %>
    <%= form.text_field :name, "Add New Status", autocomplete: "off" %>
    <div class="flex flex-wrap items-center gap-y-2">
      <label for="project_status_color" class="text-sm">Appearance</label>
      <%= render Ui::ColorPickerComponent.new(name: "project_status[color]", selected: "gray", id_prefix: "new_project_status") %>
    </div>
    <div class="flex justify-end">
      <%= render Ui::SubmitButtonComponent.new(form, "Save") %>
    </div>
  </div>
<% end %>

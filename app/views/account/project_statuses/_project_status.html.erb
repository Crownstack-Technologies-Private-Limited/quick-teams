<%= turbo_frame_tag dom_id(project_status) do %>
  <%= render Ui::ListRowComponent.new(title: project_status.name.titleize) do |row| %>
    <% row.with_leading { render Ui::StatusDotComponent.new(color: project_status.color, class: "flex-shrink-0", "aria-hidden": "true") } %>
    <% row.with_actions do %>
      <%= edit_button(edit_account_project_status_path(project_status)) %>
      <%= delete_button(account_project_status_path(project_status)) %>
    <% end %>
  <% end %>
<% end %>

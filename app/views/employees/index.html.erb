<%= render Ui::PageComponent.new do %>
  <%= render Ui::PageHeaderComponent.new(title: "People", subtitle: "(" + @pagy.count.to_s + " employees)") do |header| %>
    <% header.with_actions do %>
      <%= render Ui::ButtonComponent.new("Add Member", href: new_employee_path) %>
    <% end %>
  <% end %>
  <!-- This example requires Tailwind CSS v2.0+ -->
  <div>
    <div class="flex flex-col">
      <div class="-my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
        <div class="inline-block min-w-full py-2 align-middle sm:px-6 lg:px-8">
          <div class="overflow-hidden border-b border-gray-200 sm:rounded-lg" >
            <%= render Ui::TableComponent.new do |table| %>
              <% table.with_column("Name", class: "bg-gray-50 border-b border-gray-200") %>
              <% table.with_column("Title", class: "bg-gray-50 border-b border-gray-200") %>
              <% table.with_column("Manager", class: "bg-gray-50 border-b border-gray-200") %>
              <% table.with_column("Team", class: "bg-gray-50 border-b border-gray-200") %>
              <% table.with_column("Status", class: "bg-gray-50 border-b border-gray-200") %>
              <% table.with_column("Permission", class: "bg-gray-50 border-b border-gray-200") %>
              <%= render partial: "employee", collection: @employees, cached: true %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
    <%= render Ui::PaginationComponent.new(@pagy) %>
  </div>
<% end %>

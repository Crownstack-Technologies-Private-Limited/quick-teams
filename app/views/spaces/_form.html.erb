<%= tailwind_form_with(model: @space, id: dom_id(@space), url: url, method: method) do |form| %>
  <%= render Ui::FormContainerComponent.new do %>
    <%= render "shared/form_messages", resource: @space, message: local_assigns[:message] %>
    <%= render "shared/form_header", title: local_assigns[:title], subtitle: local_assigns[:subtitle] %>
    <%= form.text_field :title, "Title", autocomplete: "off" %>
    <%= form.text_area :description, "Description", autocomplete: "off" %>
    <input type="hidden" name="space[user_id]" value="<%= current_user.id %>">
    <%= render Ui::FormFieldComponent.new(label: "Select people who can see this space", for_id: "space_users") do %>
      <%= select_tag "space[users][]", options_for_select(users.map { |user| [user.decorate.display_name, user.id] }, space_users), id: "space_users", multiple: true, data: { controller: "slimselect" }, class: "form-text-field capitalize" %>
    <% end %>
    <%= render Ui::FormActionsComponent.new do %>
      <%= render Ui::BackButtonComponent.new() %>
      <%= render Ui::SubmitButtonComponent.new(form, "Save", class: "ml-2") %>
    <% end %>
  <% end %>
<% end %>

<%= render Ui::TimelineItemComponent.new(user: event.user, timestamp: display_created_at(event)) do %>
  <%= render Ui::TextLinkComponent.new(event.user.decorate.display_name, employee_timeline_path(event.user), tone: :strong) %>
  freed  employee
  <%= render Ui::TextLinkComponent.new(event.eventable.decorate.display_name, employee_schedules_path(event.eventable), tone: :strong) %>
  from project
              <% if event.trackable.present? %>

  <%= render Ui::TextLinkComponent.new(event.trackable.name.titleize, project_schedules_path(event.trackable), tone: :strong) %>
  <% else %>
  which does not exist anymore
  <% end %>
<% end %>

<%= render Ui::TimelineItemComponent.new(user: event.user, timestamp: display_created_at(event)) do %>
  <% if event.eventable_type == "User" %>
    <%= render Ui::TextLinkComponent.new(event.user.decorate.display_name, employee_surveys_path(event.user), tone: :strong) %>
    submitted a survey 
    <% if event.trackable.nil? %>
      which does not exists anymore 
    <% else %>
      titled
      <%= render Ui::TextLinkComponent.new(highlight_hashtag(event.trackable.survey.name.upcase_first), survey_report_preview_path(event.trackable.survey, event.trackable), tone: :strong) %>
    <% end %>
  <% else %>
    <%= render Ui::TextLinkComponent.new(event.user.decorate.display_name, employee_surveys_path(event.user), tone: :strong) %>
    submitted a survey
    <% if event.trackable.nil? %>
      which does not exists anymore 
    <% else %>
      titled
      <%= render Ui::TextLinkComponent.new(highlight_hashtag(event.trackable.survey.name.upcase_first), survey_report_preview_path(event.trackable.survey, event.trackable), tone: :strong) %>
    <% end %>
    for
    <%= render Ui::TextLinkComponent.new(event.eventable.decorate.display_name, project_surveys_path(event.eventable), tone: :strong) %>
  <% end %>
<% end %>

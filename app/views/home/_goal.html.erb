<%= render Ui::TimelineItemComponent.new(user: event.user, timestamp: display_created_at(event)) do %>
  <%= render Ui::TextLinkComponent.new(event.user.decorate.display_name, employee_timeline_path(event.user), tone: :strong) %>
  added a new goal 
  <% if event.trackable.nil? %>
    which does not exists anymore 
  <% else %>
    titled
    <%= render Ui::TextLinkComponent.new(highlight_hashtag(event.trackable.title.upcase_first), employee_goal_path(event.eventable, event.trackable), tone: :strong) %>
  <% end %>
  for
  <%= render Ui::TextLinkComponent.new(event.eventable.decorate.display_name, employee_goals_path(event.eventable), tone: :strong) %>
<% end %>

<turbo-frame id="events">
  <ul>
    <% @events.each do |event| %>
      <% if lookup_context.template_exists?(event.action, "home", true) %>
        <% cache [event, event.user] do %>
          <%= render partial: event.action, locals: { event: event } %>
        <% end %>
      <% end %>
    <% end %>
  </ul>
  <% if @events.size > 0 %>
    <%= render Ui::TextComponent.new("Showing #{50} recently created events only.", align: :right, class: "pr-4 mt-2") %>
  <% else %>
    <%= render Ui::TextComponent.new("No record found.", align: :right, class: "pr-4 mt-2") %>
  <% end %>
</turbo-frame>

<%= render Ui::PageComponent.new do %>
  <%= render Ui::SplitLayoutComponent.new do |layout| %>
    <% layout.with_primary do %>
      <section aria-labelledby="participants_section">
        <div class="overflow-hidden bg-white">
          <div class="p-4">
            <div class="flex flex-wrap">
              <p class="pb-2 mt-1 text-sm font-medium text-gray-900 truncate"><%= "Recent Activities" %></p>
            </div>
            <%= turbo_frame_tag "events", src: events_path, target: "_top", loading: :lazy do %>
              <%= render Ui::LoadingComponent.new("Hold on a sec while I fetch events...") %>
            <% end %>
          </div>
        </div>
      </section>

    <% end %>
    <% layout.with_secondary do %>
      <section aria-labelledby="add-participant-section">
        <div class="overflow-hidden bg-white">
          <div class="p-4">
            <div class="flex flex-wrap">
              <p class="pb-2 mt-1 text-sm font-medium text-gray-900 truncate"><%= "90 days' goals/milestones window" %></p>
            </div>
            <%= turbo_frame_tag "goals", src: goals_path, target: "_top", loading: :lazy do %>
              <%= render Ui::LoadingComponent.new("Hold on a sec while I fetch goals...") %>
            <% end %>
          </div>
        </div>
      </section>

    <% end %>
  <% end %>
<% end %>

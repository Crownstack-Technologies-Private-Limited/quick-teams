<%= render Ui::SettingsLayoutComponent.new(menu: :archive, width: :wide) do %>
      <div class="overflow-hidden bg-white">
        <div class="pb-4 ml-4">
          <%= render "shared/form_header", title: "Archived Projects", subtitle: @projects.load.size > 0 ? "Following projects have been archived." : "No record found." %>
        </div>
        <% if @projects.load.size > 0 %>
          <div class=" flex space-x-4 ml-4">
            <%= render Ui::SearchFieldComponent.new(url: "/search/archived", placeholder: "Search", sr_label: "Search", wrapper_class: "flex-1 min-w-0") %>
          </div>
        <% end %>
        <div class="overflow-hidden bg-white " data-controller="infinite-scroll">
          <div>
            <table class="table pt-4 border-separate">
              <thead class="bg-gray-50">
              </thead>
              <tbody class="table-body " id="projects" data-infinite-scroll-target="entries">
                <%= render partial: "projects/archived_project", collection: @projects, as: :project, cached: true %>
              </tbody>
            </table>
            <%= render Ui::PaginationComponent.new(@pagy, class: "invisible", data: { "infinite-scroll-target": "pagination" }) %>
          </div>
        
<% end %>

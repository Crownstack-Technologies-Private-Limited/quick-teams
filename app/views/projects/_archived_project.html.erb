<% project = project.decorate %>
<tr>
  <td class="w-full table-cell whitespace-nowrap">
    <div class="flex items-center">
      <div class="flex-1 min-w-0 sm:flex sm:items-center sm:justify-between">
        <div>
          <a href="<%= project_schedules_path(project) %>" class="truncate hover:text-gray-600 hover:underline">
            <div class="flex text-sm font-medium text-gray-600 truncate">
              <p> <%= project.display_name %></p>
              <p class="ml-1 font-normal text-gray-500">
                <%= project.display_discipline %>
              </p>
            </div>
          </a>
          <div class="flex-1 w-full mt-2">
            <div class="flex items-center text-sm text-gray-500">
              <%= render Ui::IconComponent.new(:calendar, class: "flex-shrink-0 mr-1.5 h-5 w-5 text-gray-400") %>
              <p>
                Archived on
                <%= project.display_archived_on %>
              </p>
            </div>
          </div>
        </div>
      </div>
    </td>
    <td class="table-cell whitespace-nowrap">
      <div class="flex justify-end">
        <%= link_to "Restore", unarchive_project_path(project), class: "btn-inline-edit mr-2" %>
        <%= delete_button(project_path(project)) %>
      </div>
    </div>
  </td>
</tr>

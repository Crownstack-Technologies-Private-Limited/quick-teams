<%# Add / edit a job card (daily planner). daily-planner#openModal fills the targets and removes "hidden". %>
<%= render Ui::ToggleModalComponent.new(id: "jobCardModal", title: "Add Job Card", title_options: { data: { "daily-planner-target": "modalTitle" } }) do |modal| %>
  <% modal.with_header_actions do %>
    <%= render Ui::ButtonComponent.new("Delete", variant: :danger, size: :sm, class: "hidden", data: { "daily-planner-target": "deleteButton", action: "click->daily-planner#deleteCard" }) %>
  <% end %>
  <form data-action="submit->daily-planner#submitForm" data-daily-planner-target="cardForm" class="space-y-4">
    <%= render Ui::FormFieldComponent.new(label: "Title", for_id: "job_card_title") do %>
      <input type="text" name="title" id="job_card_title" class="w-full form-text-field" required data-daily-planner-target="titleInput" autocomplete="off">
    <% end %>
    <%= render Ui::FormFieldComponent.new(label: "Description", for_id: "job_card_description") do %>
      <textarea name="description" id="job_card_description" class="w-full form-text-field h-20" data-daily-planner-target="descriptionInput"></textarea>
    <% end %>
    <%= render Ui::FormFieldComponent.new(label: "Duration", for_id: "job_card_slot_length") do %>
      <select name="slot_length" id="job_card_slot_length" class="w-full form-text-field" required data-daily-planner-target="slotLengthInput">
        <% (1..9).each do |slots| %>
          <option value="<%= slots %>"><%= slots %> slot<%= "s" if slots > 1 %> (<%= slot_duration_label(slots) %>)</option>
        <% end %>
      </select>
    <% end %>
    <%= render Ui::FormFieldComponent.new(label: "Color (Optional)") do %>
      <%= render Ui::ColorChoiceComponent.new(name: "color", selected: "gray", input_data: { "daily-planner-target": "colorInput" }, options: [
            ["green", "Deep Work, Important or priority tasks"],
            ["yellow", "Standups, Maintenance, routine, or admin tasks"],
            ["blue", "Meetings, Discussions, or Team management"],
            ["gray", "Breaks, Learning or fun activities"],
            ["red", "Time Wasters, Distractions, obsolete, or adhoc tasks"],
          ]) %>
    <% end %>
    <input type="hidden" name="date" value="<%= @date.iso8601 %>">
    <input type="hidden" name="session" data-daily-planner-target="modalSession">
    <input type="hidden" name="slot_start" data-daily-planner-target="modalSlot">
    <input type="hidden" name="card_id" data-daily-planner-target="cardId">
    <input type="hidden" name="user_id" value="<%= @user.id %>">
    <%= render Ui::FormActionsComponent.new do %>
      <%= render Ui::ButtonComponent.new("Cancel", variant: :secondary, data: { action: "click->daily-planner#closeModal" }) %>
      <%= render Ui::ButtonComponent.new("Save", type: "submit", class: "ml-2", data: { "daily-planner-target": "saveButton" }) %>
    <% end %>
  </form>
<% end %>

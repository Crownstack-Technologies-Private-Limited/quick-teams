<%# Read-only details of a job card (weekly planner). weekly-planner#showCardDetails fills the targets and removes "hidden". %>
<%= render Ui::ToggleModalComponent.new(id: "jobCardDetailsModal", title: "Job Card Details") do |modal| %>
  <% modal.with_header_actions do %>
    <%= render Ui::ButtonComponent.new(variant: :icon, "aria-label": "Close", data: { action: "click->weekly-planner#closeDetailsModal" }) do %>
      <%= render Ui::IconComponent.new(:x, class: "h-5 w-5") %>
    <% end %>
  <% end %>
  <div class="space-y-3">
    <%= render Ui::FormFieldComponent.new(label: "Title") do %>
      <div class="form-text-field" data-weekly-planner-target="detailsTitle"></div>
    <% end %>
    <%= render Ui::FormFieldComponent.new(label: "Description") do %>
      <div class="form-text-field h-24" data-weekly-planner-target="detailsDescription"></div>
    <% end %>
    <div class="grid grid-cols-2 gap-4">
      <%= render Ui::FormFieldComponent.new(label: "Date") do %>
        <div class="form-text-field" data-weekly-planner-target="detailsDate"></div>
      <% end %>
      <%= render Ui::FormFieldComponent.new(label: "Session") do %>
        <div class="form-text-field capitalize" data-weekly-planner-target="detailsSession"></div>
      <% end %>
    </div>
    <%= render Ui::FormFieldComponent.new(label: "Duration") do %>
      <div class="form-text-field" data-weekly-planner-target="detailsDuration"></div>
    <% end %>
  </div>
  <%= render Ui::FormActionsComponent.new do %>
    <%= render Ui::ButtonComponent.new("Close", class: "mt-6", data: { action: "click->weekly-planner#closeDetailsModal" }) %>
  <% end %>
<% end %>

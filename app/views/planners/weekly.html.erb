<div data-controller="weekly-planner" data-weekly-planner-start-date-value="<%= @start_date.iso8601 %>">
  <%= render Ui::PageHeaderComponent.new(title: "#{@user.first_name}'s Weekly Planner - #{@start_date.strftime('%B %d')} - #{(@start_date + 4.days).strftime('%B %d, %Y')}", heading_tag: :h2, bordered: false) do |header| %>
    <% header.with_actions do %>
      <%= render Ui::SegmentedLinksComponent.new(label: "Planner view") do |links| %>
        <% links.with_link("Daily Planner", employee_planner_daily_path) %>
        <% links.with_link("Weekly Planner", employee_planner_weekly_path, selected: true) %>
      <% end %>
      <%= render Ui::SegmentedLinksComponent.new(label: "Change week") do |links| %>
        <% links.with_link("← Previous", employee_planner_weekly_path(week: @start_date - 1.week)) %>
        <% links.with_link("This Week", employee_planner_weekly_path, selected: @start_date == Date.current.beginning_of_week) %>
        <% links.with_link("Next →", employee_planner_weekly_path(week: @start_date + 1.week)) %>
      <% end %>
    <% end %>
  <% end %>

  <div class="grid grid-cols-1 gap-4 px-4 pb-8 md:grid-cols-5 md:h-screen">
    <% @dates.each do |date| %>
      <%= render Ui::CardComponent.new(title: link_to(date.strftime("%a %m/%d"), employee_planner_daily_path(date: date), class: "hover:text-primary-700 hover:underline"), heading_tag: :h3, padded: false, body_class: "flex-1 flex flex-col", class: "h-full flex flex-col") do %>
        <div class="p-2 flex flex-col space-y-2 flex-1">
          <% %w[morning afternoon evening].each do |session| %>
            <%= render Ui::SessionLaneComponent.new(date: date.iso8601, session: session) do %>
              <% cards = @grouped_cards[[date, session]] %>
              <% if cards && cards.any? %>
                <% color_priority = { "bg-green-400" => 1, "bg-yellow-400" => 2, "bg-blue-400" => 3, "bg-gray-400" => 4, "bg-red-400" => 5 } %>
                <% cards_by_color = cards.group_by(&:weekly_color_class).sort_by { |color, _| color_priority[color] || 6 }.flat_map { |_, group| group } %>
                <% cards_by_color.each_with_index do |card, index| %>
                  <%= render Ui::JobCardComponent.new(title: card.title, color_class: card.weekly_color_class, variant: :weekly,
                        style: "top: #{index * 11.11}%; z-index: 1; height: calc(#{(card.slot_length.to_f / 9 * 100).round(2)}% - 0.25rem);",
                        data: { "card-id": card.id, action: "click->weekly-planner#showCardDetails" }) %>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>

  <%= render "planners/view_job_card" %>
</div>

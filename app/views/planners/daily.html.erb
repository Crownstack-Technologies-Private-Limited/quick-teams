<div
  data-controller="daily-planner"
  data-daily-planner-date-value="<%= @date.iso8601 %>"
  data-daily-planner-editable-value="<%= @date >= Date.current %>"
>
  <%= render Ui::PageHeaderComponent.new(title: "#{@user.first_name}'s Daily Planner - #{@date.strftime('%A, %B %d, %Y')}", heading_tag: :h2, bordered: false) do |header| %>
    <% header.with_actions do %>
      <%= render Ui::SegmentedLinksComponent.new(label: "Planner view") do |links| %>
        <% links.with_link("Daily Planner", employee_planner_daily_path, selected: true) %>
        <% links.with_link("Weekly Planner", employee_planner_weekly_path) %>
      <% end %>
      <%= render Ui::SegmentedLinksComponent.new(label: "Change day") do |links| %>
        <% links.with_link("← Previous", employee_planner_daily_path(date: @date - 1.day)) %>
        <% links.with_link("Today", employee_planner_daily_path, selected: @date == Date.current) %>
        <% links.with_link("Next →", employee_planner_daily_path(date: @date + 1.day)) %>
      <% end %>
    <% end %>
  <% end %>

  <div class="grid grid-cols-1 gap-6 px-4 pb-8 md:grid-cols-3">
    <% %w[morning afternoon evening].each do |session| %>
      <%= render Ui::CardComponent.new(title: "#{session.capitalize} (3 hours)", heading_tag: :h3) do %>
        <div class="relative">
          <% 9.times do |slot_index| %>
            <% slot_number = slot_index + 1 %>
            <% existing_card = @grouped_cards[[session, slot_number]]&.first %>
            <%= render Ui::TimeSlotComponent.new(session: session, number: slot_number) do %>
              <% if existing_card %>
                <%= render Ui::JobCardComponent.new(title: existing_card.title, color_class: existing_card.color_class,
                      duration: slot_duration_label(existing_card.slot_length, spaced: true),
                      description: (existing_card.description if existing_card.slot_length > 1),
                      style: "height: #{(existing_card.slot_length * 2.5) + ((existing_card.slot_length - 1) * 0.25)}rem; z-index: 1;",
                      data: { "card-id": existing_card.id }) %>
              <% end %>
            <% end %>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>

  <%= render "planners/create_job_card" %>
</div>

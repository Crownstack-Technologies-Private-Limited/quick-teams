<%= render Ui::FormContainerComponent.new(width: "max-w-2xl", class: "mt-4") do %>
  <%= render Ui::LinkListComponent.new(title: "Timesheets", first: true) do |list| %>
    <% list.with_link("Timesheets Report", timesheets_reports_path) %>
    <% list.with_link("What happened yesterday?", timesheets_reports_path(from_date: Date.yesterday, to_date: Date.today)) %>
  <% end %>
  <%= render Ui::LinkListComponent.new(title: "Goals") do |list| %>
    <% list.with_link("Last Week's Goals Status Report", goals_reports_path(from_date: Date.today - 7.days, to_date: Date.today)) %>
    <% list.with_link("Last Month's Goals Status Report", goals_reports_path(from_date: Date.today - 30.days, to_date: Date.today)) %>
    <% list.with_link("Last Quarter's Goals Status Report", goals_reports_path(from_date: Date.today - 90.days, to_date: Date.today)) %>
    <% list.with_link("Pending goals created by me", goals_reports_path(status: 0, to_date: Date.today, created_by: current_user.id)) %>
    <% list.with_link("Recently completed goals", goals_reports_path(status: 1, from_date: Date.today - 30.days, to_date: Date.today, order_by: "updated_at", order: "desc")) %>
    <% list.with_link("Recently Added pending goals", goals_reports_path(status: 0, order: "desc", order_by: "created_at")) %>
    <% list.with_link("Recently Updated pending goals", goals_reports_path(status: 0, order: "desc", order_by: "updated_at")) %>
    <% list.with_link("Pending employee goals which should have been completed by now", goals_reports_path(status: 0, to_date: Date.today, type: "User")) %>
    <% list.with_link("Pending project milestones which should have been completed by now", goals_reports_path(status: 0, to_date: Date.today, type: "Project")) %>
    <% list.with_link("All Pending goals", goals_reports_path(status: 0)) %>
  <% end %>
  <%= render Ui::LinkListComponent.new(title: "Schedules") do |list| %>
    <% list.with_link("Available Resources", available_schedules_reports_path) %>
    <% list.with_link("Employees with no schedule", no_schedule_reports_path) %>
    <% list.with_link("Employees with no project", no_projects_schedules_reports_path) %>
    <% list.with_link("Overburdened Resources", overburdened_schedules_reports_path) %>
    <% list.with_link("Resources shared in multiple projects", shared_schedules_reports_path) %>
    <% list.with_link("Schedules by Jobs, Roles and Discipline", roles_schedule_reports_path) %>
  <% end %>
  <%= render Ui::LinkListComponent.new(title: "Todos") do |list| %>
    <% list.with_link("Pending Todos created by me", my_pending_todos_path) %>
    <% list.with_link("Pending Todos which should have been completed by now", pending_todos_path) %>
    <% list.with_link("All Pending Todos", all_pending_todos_path) %>
    <% list.with_link("Recently Added Pending Todos", recently_added_todos_path) %>
    <% list.with_link("Recetly Finished Todos", recently_finished_todos_path) %>
  <% end %>
  <%= render Ui::LinkListComponent.new(title: "Projects") do |list| %>
    <% list.with_link("Projects Risks Report", projects_risks_reports_path) %>
    <% list.with_link("Projects Observers Report", projects_observers_reports_path) %>
  <% end %>
  <%= render Ui::LinkListComponent.new(title: "Employees") do |list| %>
    <% list.with_link("Employees Report", employees_reports_path) %>
    <% list.with_link("Employees Skills Report", skills_reports_path) %>
    <% list.with_link("Employees KRAs Report", kpis_reports_path) %>
    <% list.with_link("Employees with no open goals", open_goals_reports_path(from_date: Date.today, to_date: Date.today + 90.days, type: "User")) %>
    <% list.with_link("Employee Submitted Reports", report_reports_path) %>
    <% list.with_link("Employees by Jobs, Roles and Discipline", employee_roles_reports_path) %>
  <% end %>
  <%= render Ui::LinkListComponent.new(title: "Miscellaneous") do |list| %>
    <% list.with_link("Activities Report", activities_reports_path(from_date: Date.today - 7.days, to_date: Date.today)) %>
  <% end %>
<% end %>

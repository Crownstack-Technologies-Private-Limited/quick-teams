<div class="relative px-8">
  <div class="flex items-center justify-between">
    <div><span class="text-xs font-medium inline-block py-1 uppercase"><%= @title %></span></div>
    <div class="text-right"><span class="text-xs font-semibold inline-block"><%= @score.to_s %></span></div>
  </div>
  <div class="overflow-hidden h-2 mb-4 text-xs flex rounded bg-gray-200" role="progressbar" aria-label="<%= @title %>" aria-valuenow="<%= @score %>" aria-valuemin="0" aria-valuemax="<%= @scale %>">
    <div style="width:<%= percentage %>%" class="shadow-none flex flex-col text-center whitespace-nowrap text-white justify-center bg-<%= color %>-400"></div>
  </div>
</div>

<div id="<%= @id %>" class="hidden fixed inset-0 bg-gray-900/50 flex items-center justify-center z-50 p-4" role="dialog" aria-modal="true" aria-labelledby="<%= title_id %>">
  <div class="bg-white rounded-xl shadow-xl p-6 w-full max-w-lg max-h-[90vh] overflow-y-auto">
    <div class="flex justify-between items-center mb-4">
      <%= tag.h3(@title, **@title_options, id: title_id, class: "text-lg leading-6 font-bold text-gray-900") %>
      <%= header_actions %>
    </div>
    <%= content %>
  </div>
</div>

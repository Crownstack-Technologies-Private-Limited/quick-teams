<div class="relative inline-block text-left <%= @wrapper_class %>" data-controller="dropdown" data-action="click@window->dropdown#hide keydown.escape@window->dropdown#hide">
  <div>
    <%= tag.button(type: "button", id: @button_id, class: button_classes, "aria-label": @label, "aria-haspopup": "true", data: { action: "click->dropdown#toggle", dropdown_target: "button" }.merge(@button_data)) do %>
      <%= trigger %>
      <% if @chevron %><%= render Ui::IconComponent.new(:chevron_down, class: "w-5 h-5 -mr-1") %><% end %>
    <% end %>
  </div>
  <div data-dropdown-target="menu" class="hidden absolute <%= align_class %> z-10 <%= @width %> mt-2 dropdown-panel focus:outline-none" role="menu" aria-orientation="vertical" tabindex="-1">
    <div class="py-1" role="none">
      <% items.each do |item| %><%= item %><% end %>
      <%= content %>
    </div>
  </div>
</div>

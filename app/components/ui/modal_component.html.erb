<div id="modal">
  <div class="fixed inset-0 z-10 overflow-y-auto" aria-labelledby="modal-title" role="dialog" aria-modal="true" data-controller="modal" data-action="keyup@document->modal#escClose">
    <div class="flex items-end justify-center min-h-screen px-4 pt-4 pb-20 text-center sm:block sm:p-0">
      <div class="fixed inset-0 transition-opacity bg-gray-900/50" aria-hidden="true"></div>
      <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>
      <div class="relative inline-block <%= panel_padding %> overflow-hidden text-left align-bottom transition-all transform bg-white rounded-xl shadow-xl sm:my-8 sm:align-middle sm:max-w-lg sm:w-full">
        <% if @title %>
          <div class="sm:flex sm:items-start">
            <% if @icon %>
              <div class="flex items-center justify-center flex-shrink-0 w-12 h-12 mx-auto rounded-full sm:mx-0 sm:h-10 sm:w-10 <%= icon_classes %>">
                <%= render Ui::IconComponent.new(@icon, class: "w-6 h-6") %>
              </div>
            <% end %>
            <div class="mt-3 text-center sm:mt-0 <%= "sm:ml-4" if @icon %> sm:text-left">
              <h3 class="text-lg font-medium leading-6 text-gray-900" id="modal-title"><%= @title %></h3>
              <% if body? %><div class="mt-2 text-sm text-gray-500"><%= body %></div><% end %>
            </div>
          </div>
        <% end %>
        <%= content %>
        <% if footer? %>
          <div class="mt-5 flex flex-col-reverse gap-3 sm:mt-4 sm:flex-row-reverse"><%= footer %></div>
        <% end %>
      </div>
    </div>
  </div>
</div>
